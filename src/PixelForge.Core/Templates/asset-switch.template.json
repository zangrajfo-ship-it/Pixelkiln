{
  "apiVersion": 1,
  "id": "asset-switch",
  "name": "Switch",
  "version": "1.0",
  "kind": "Asset",
  "primary": "char",
  "tags": [
    "asset",
    "switch"
  ],
  "description": "Lever with off and on states; target names what it opens.",
  "parameters": [
    {
      "key": "name",
      "label": "Name",
      "default": "switch"
    },
    {
      "key": "seed",
      "label": "Seed (number or word)",
      "default": "switch"
    },
    {
      "key": "palette",
      "label": "Palette",
      "default": "(default)",
      "source": "Palette"
    }
  ],
  "steps": [
    {
      "id": "sprite",
      "type": "sprite",
      "name": "{name}",
      "core": true,
      "settings": {
        "width": "16",
        "height": "16",
        "seed": "{seed}",
        "density": "0.6",
        "palette": "{palette}"
      },
      "states": [
        {
          "name": "off",
          "frames": 1
        },
        {
          "name": "on",
          "frames": 1
        }
      ]
    },
    {
      "id": "char",
      "type": "character",
      "name": "{name}",
      "core": true,
      "settings": {
        "spriteStep": "sprite",
        "kind": "Item",
        "origin": "feet"
      },
      "boxes": [
        {
          "kind": "Trigger",
          "rect": "full"
        }
      ],
      "properties": {
        "target": "",
        "once": "false"
      }
    }
  ]
}
