{
  "apiVersion": 1,
  "id": "sample-hero",
  "name": "Sample: pixel hero",
  "version": "1.0",
  "kind": "Character",
  "primary": "char",
  "tags": [
    "sample",
    "learn",
    "character",
    "player",
    "platformer",
    "pixel art"
  ],
  "description": "A hand-drawn 16 px hero with idle (blinks), run and jump animations and hitboxes. Open it in the Sprite tab to see how the frames are drawn.",
  "parameters": [
    {
      "key": "name",
      "label": "Name",
      "default": "hero"
    }
  ],
  "steps": [
    {
      "id": "art",
      "type": "art",
      "name": "{name}",
      "core": true,
      "settings": {
        "art": "hero"
      }
    },
    {
      "id": "char",
      "type": "character",
      "name": "{name}",
      "core": true,
      "settings": {
        "spriteStep": "art",
        "kind": "Player",
        "origin": "feet"
      },
      "boxes": [
        {
          "kind": "Hurt",
          "rect": "body"
        },
        {
          "kind": "Solid",
          "rect": "feet",
          "category": 1
        }
      ],
      "properties": {
        "speed": "90",
        "jump": "230",
        "gravity": "640"
      }
    }
  ]
}
