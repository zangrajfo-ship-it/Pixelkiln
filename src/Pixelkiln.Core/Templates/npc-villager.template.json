{
  "apiVersion": 1,
  "id": "npc-villager",
  "name": "NPC",
  "version": "1.0",
  "kind": "Character",
  "primary": "char",
  "tags": [
    "character",
    "npc"
  ],
  "description": "Friendly character that idles and talks.",
  "parameters": [
    {
      "key": "name",
      "label": "Name",
      "default": "villager"
    },
    {
      "key": "size",
      "label": "Size (px)",
      "default": "24",
      "options": [
        "16",
        "24",
        "32",
        "48",
        "64"
      ]
    },
    {
      "key": "seed",
      "label": "Seed (number or word)",
      "default": "villager"
    },
    {
      "key": "style",
      "label": "Style (fill density)",
      "default": "0.45",
      "options": [
        "0.38",
        "0.45",
        "0.52",
        "0.6"
      ]
    },
    {
      "key": "palette",
      "label": "Palette",
      "default": "(default)",
      "source": "Palette"
    }
  ],
  "steps": [
    {
      "id": "sprite",
      "type": "sprite",
      "name": "{name}",
      "core": true,
      "settings": {
        "width": "{size}",
        "height": "{size}",
        "seed": "{seed}",
        "density": "{style}",
        "palette": "{palette}"
      },
      "states": [
        {
          "name": "idle",
          "frames": 2
        },
        {
          "name": "talk",
          "frames": 2
        }
      ]
    },
    {
      "id": "char",
      "type": "character",
      "name": "{name}",
      "core": true,
      "settings": {
        "spriteStep": "sprite",
        "kind": "Npc",
        "origin": "feet"
      },
      "boxes": [
        {
          "kind": "Trigger",
          "rect": "full"
        }
      ],
      "properties": {
        "dialog": "Hello, traveller!"
      }
    }
  ]
}
