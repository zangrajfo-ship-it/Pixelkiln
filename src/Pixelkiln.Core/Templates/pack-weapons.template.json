{
  "apiVersion": 1,
  "id": "pack-weapons",
  "name": "Weapons and gear",
  "version": "1.0",
  "kind": "Asset",
  "primary": "items",
  "tags": [
    "asset",
    "weapon",
    "icon"
  ],
  "description": "Sword, shield, bow, staff, axe and armor icons.",
  "parameters": [
    {
      "key": "names",
      "label": "Names (commas)",
      "default": "sword, shield, bow, staff, axe, armor"
    },
    {
      "key": "size",
      "label": "Size (px)",
      "default": "16",
      "options": [
        "8",
        "12",
        "16",
        "24",
        "32"
      ]
    },
    {
      "key": "seed",
      "label": "Seed (number or word)",
      "default": "pack-weapons"
    },
    {
      "key": "palette",
      "label": "Palette",
      "default": "(default)",
      "source": "Palette"
    }
  ],
  "steps": [
    {
      "id": "items",
      "type": "items",
      "core": true,
      "settings": {
        "names": "{names}",
        "size": "{size}",
        "seed": "{seed}",
        "palette": "{palette}"
      }
    }
  ]
}
