    },
    {
      "key": "width",
      "label": "Design width",
      "default": "320",
      "options": [
        "320",
        "480",
        "640",
        "1280",
        "1920"
      ]
    },
    {
      "key": "height",
      "label": "Design height",
      "default": "180",
      "options": [
        "180",
        "270",
        "360",
        "720",
        "1080"
      ]
    },
    {
      "key": "pixel",
      "label": "Pixel-art edges",
      "default": "true",
      "options": [
        "true",
        "false"
      ]
    }
  ],
  "steps": [
    {
      "id": "ui",
      "type": "ui",
      "name": "{name} ui",
      "core": true,
      "settings": {
        "style": "Candy",
        "screens": "{screens}",
        "width": "{width}",
        "height": "{height}",
        "pixel": "{pixel}"
