{
  "apiVersion": 1,
  "id": "ui-candy",
  "name": "UI kit: candy",
  "version": "1.0",
  "kind": "Scene",
  "primary": "ui",
  "tags": [
    "ui",
    "menu",
    "hud",
    "casual"
  ],
  "description": "Bright rounded casual-game interface with all standard screens.",
  "parameters": [
    {
      "key": "name",
      "label": "Name",
      "default": "candy"
