{
  "apiVersion": 1,
  "id": "asset-ladder",
  "name": "Ladder",
  "version": "1.0",
  "kind": "Asset",
  "primary": "char",
  "tags": [
    "asset",
    "ladder"
  ],
  "description": "Climbable ladder: a trigger area with climb=true.",
  "parameters": [
    {
      "key": "name",
      "label": "Name",
      "default": "ladder"
    },
    {
      "key": "seed",
      "label": "Seed (number or word)",
      "default": "ladder"
    },
    {
      "key": "palette",
      "label": "Palette",
      "default": "(default)",
      "source": "Palette"
    }
  ],
  "steps": [
    {
      "id": "sprite",
      "type": "sprite",
      "name": "{name}",
      "core": true,
      "settings": {
        "width": "16",
        "height": "32",
        "seed": "{seed}",
        "density": "0.6",
        "palette": "{palette}"
      },
      "states": [
        {
          "name": "idle",
          "frames": 1
        }
      ]
    },
    {
      "id": "char",
      "type": "character",
      "name": "{name}",
      "core": true,
      "settings": {
        "spriteStep": "sprite",
        "kind": "Item",
        "origin": "feet"
      },
      "boxes": [
        {
          "kind": "Trigger",
          "rect": "full"
        }
      ],
      "properties": {
        "climb": "true"
      }
    }
  ]
}
