<UserControl x:Class="PixelForge.App.SfxEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Content="▶ Play" ToolTip="Space" Click="OnPlay" />
            <Separator />
            <Button Content="Open" ToolTip="Ctrl+O" Click="OnOpen" />
            <Button Content="Save" ToolTip="Ctrl+S" Click="OnSave" />
            <Button Content="Save as" Click="OnSaveAs" />
            <Button Content="Export WAV" Click="OnExportWav" />
            <Separator />
            <TextBlock x:Name="Status" VerticalAlignment="Center" Margin="8,0" />
        </ToolBar>

        <StackPanel x:Name="PresetPanel" DockPanel.Dock="Left" Width="110" Margin="4">
            <TextBlock Text="New sound" FontWeight="SemiBold" Margin="2,0,0,4" />
        </StackPanel>

        <Border DockPanel.Dock="Top" Height="120" Margin="4" Background="#2B2B2B">
            <Canvas x:Name="WaveCanvas" ClipToBounds="True" SizeChanged="OnWaveSize">
                <Polyline x:Name="WaveLine" Stroke="#6ABE30" StrokeThickness="1" />
            </Canvas>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ParamsPanel" Margin="8" MaxWidth="560" HorizontalAlignment="Left" />
        </ScrollViewer>
    </DockPanel>
</UserControl>
