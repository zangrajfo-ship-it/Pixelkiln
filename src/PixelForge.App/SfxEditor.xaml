<UserControl x:Class="PixelForge.App.SfxEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button ToolTip="Play sound (Space)" Click="OnPlay">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE768;" /><TextBlock Text=" Play" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Separator />
                <Button ToolTip="Open (Ctrl+O)" Click="OnOpen"><TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" /></Button>
                <Button ToolTip="Save (Ctrl+S)" Click="OnSave"><TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" /></Button>
                <Separator />
                <Button ToolTip="Export WAV" Click="OnExportWav">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" /><TextBlock Text=" Export WAV" VerticalAlignment="Center" /></StackPanel>
                </Button>
            </ToolBar>
        </ToolBarTray>
        <Border DockPanel.Dock="Bottom" Padding="10,4" BorderThickness="0,1,0,0" BorderBrush="#3A3A3A">
            <TextBlock x:Name="Status" />
        </Border>

        <StackPanel x:Name="PresetPanel" DockPanel.Dock="Left" Width="110" Margin="4">
            <TextBlock Text="New sound" FontWeight="SemiBold" Margin="2,0,0,4" />
        </StackPanel>

        <Border DockPanel.Dock="Top" Height="120" Margin="4" Background="#2B2B2B">
            <Canvas x:Name="WaveCanvas" ClipToBounds="True" SizeChanged="OnWaveSize">
                <Polyline x:Name="WaveLine" Stroke="#6ABE30" StrokeThickness="1" />
            </Canvas>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ParamsPanel" Margin="8" MaxWidth="560" HorizontalAlignment="Left" />
        </ScrollViewer>
    </DockPanel>
</UserControl>
