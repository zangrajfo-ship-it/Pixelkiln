<UserControl x:Class="PixelForge.App.TilemapEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <UserControl.Resources>
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button ToolTip="New map (Ctrl+N)" Click="OnNew"><TextBlock Style="{StaticResource Icon}" Text="&#xE7C3;" /></Button>
                <Button ToolTip="Open (Ctrl+O)" Click="OnOpen"><TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" /></Button>
                <Button ToolTip="Save (Ctrl+S)" Click="OnSave"><TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" /></Button>
                <Separator />
                <Button ToolTip="Undo (Ctrl+Z)" Click="OnUndo"><TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" /></Button>
                <Button ToolTip="Redo (Ctrl+Y)" Click="OnRedo"><TextBlock Style="{StaticResource Icon}" Text="&#xE7A6;" /></Button>
                <Separator />
                <Button ToolTip="Zoom out (Ctrl+-)" Click="OnZoomOut"><TextBlock Style="{StaticResource Icon}" Text="&#xE71F;" /></Button>
                <TextBlock x:Name="ZoomText" Width="52" TextAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Zoom level" />
                <Button ToolTip="Zoom in (Ctrl+=)" Click="OnZoomIn"><TextBlock Style="{StaticResource Icon}" Text="&#xE8A3;" /></Button>
                <Button ToolTip="Fit to window (Ctrl+0)" Click="OnZoomFit"><TextBlock Style="{StaticResource Icon}" Text="&#xE9A6;" /></Button>
                <Separator />
                <CheckBox x:Name="GridToggle" Content="Grid" ToolTip="Grid (Ctrl+G)" IsChecked="True" Click="OnGridToggle" />
                <Separator />
                <TextBlock x:Name="ToolHint" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource MutedText}" />
            </ToolBar>
        </ToolBarTray>
        <Border DockPanel.Dock="Bottom" Padding="10,4" BorderThickness="0,1,0,0" BorderBrush="#3A3A3A">
            <TextBlock x:Name="Status" />
        </Border>

        <StackPanel DockPanel.Dock="Left" Width="96" Margin="4">
            <RadioButton x:Name="PaintBtn" Content="Paint  B" ToolTip="Paint (B): paints the selected tiles (drag in the tileset for several). Right mouse erases." IsChecked="True" GroupName="mtool" Click="OnToolClick" />
            <RadioButton x:Name="EraseBtn" Content="Erase  E" ToolTip="Erase (E)" GroupName="mtool" Click="OnToolClick" />
            <RadioButton x:Name="FillBtn" Content="Fill  G" ToolTip="Fill (G): fills with the selected tiles as a pattern" GroupName="mtool" Click="OnToolClick" />
            <RadioButton x:Name="PickBtn" Content="Pick  I" ToolTip="Pick (I): click or drag on the map to copy tiles" GroupName="mtool" Click="OnToolClick" />
            <RadioButton x:Name="AutoBtn" Content="Auto  A" ToolTip="Auto-tile (A): paints the selected terrain, edges connect by themselves. Right mouse erases." GroupName="mtool" Click="OnToolClick" />
            <RadioButton x:Name="ObjectBtn" Content="Object  O" ToolTip="Objects (O): drag = box, click = point. Click an object to select/move it. Shift snaps to tiles. Del removes." GroupName="mtool" Click="OnToolClick" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Right" Width="260" Margin="4">
            <TextBlock DockPanel.Dock="Top" Text="Tileset" Margin="0,0,0,4" />
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <Button Content="Load…" ToolTip="PNG or .pxf" Click="OnLoadTileset" Margin="0,0,4,0" />
                <Button Content="From Sprite tab" ToolTip="Use the sprite's current frame" Click="OnTilesetFromSprite" Margin="0,0,4,0" />
                <Button Content="Reload" ToolTip="Re-read the tileset file" Click="OnReloadTileset" />
            </WrapPanel>
            <ScrollViewer DockPanel.Dock="Top" Height="300" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#2B2B2B">
                <Grid x:Name="TilesetHost" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="Hand" Focusable="True" Background="Transparent"
                      AutomationProperties.Name="Tileset. Arrow keys select a tile, Shift+arrows select several." KeyDown="OnTilesetKey"
                      MouseLeftButtonDown="OnTilesetDown" MouseMove="OnTilesetMove" MouseLeftButtonUp="OnTilesetUp">
                    <Image x:Name="TilesetImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <Rectangle x:Name="TilesetGrid" IsHitTestVisible="False" />
                    <Canvas IsHitTestVisible="False">
                        <Rectangle x:Name="SelectionRect" Stroke="Yellow" StrokeThickness="2" />
                    </Canvas>
                </Grid>
            </ScrollViewer>
            <DockPanel DockPanel.Dock="Top" Margin="0,6,0,0">
                <Label Content="_Terrain" Target="{Binding ElementName=TerrainBox}" VerticalAlignment="Center" Padding="0,0,6,0" />
                <Button DockPanel.Dock="Right" Content="Template…" ToolTip="Save a 4×4 guide PNG showing which tile goes where" Click="OnTerrainTemplate" />
                <Button ToolTip="Remove terrain" Click="OnRemoveTerrain" DockPanel.Dock="Right"><TextBlock Style="{StaticResource Icon}" Text="&#xE738;" /></Button>
                <Button ToolTip="Add terrain from the selected 4×4 tiles" Click="OnAddTerrain" DockPanel.Dock="Right"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" /></Button>
                <ComboBox x:Name="TerrainBox" AutomationProperties.Name="Terrain" Margin="0,0,4,0" />
            </DockPanel>
            <StackPanel x:Name="ObjectPanel" DockPanel.Dock="Bottom" Margin="0,8,0,0" Visibility="Collapsed">
                <TextBlock Text="Selected object" FontWeight="SemiBold" />
                <DockPanel Margin="0,4,0,0"><Label Content="_Name" Target="{Binding ElementName=ObjNameBox}" Width="44" VerticalAlignment="Center" Padding="0" /><TextBox x:Name="ObjNameBox" AutomationProperties.Name="Object name" LostKeyboardFocus="OnObjectFieldCommit" KeyDown="OnObjectFieldKey" /></DockPanel>
                <DockPanel Margin="0,4,0,0"><Label Content="T_ype" Target="{Binding ElementName=ObjTypeBox}" Width="44" VerticalAlignment="Center" Padding="0" /><TextBox x:Name="ObjTypeBox" AutomationProperties.Name="Object type" LostKeyboardFocus="OnObjectFieldCommit" KeyDown="OnObjectFieldKey" /></DockPanel>
                <DockPanel Margin="0,4,0,0">
                    <Button DockPanel.Dock="Right" Content="Delete" Click="OnDeleteObject" />
                    <TextBlock x:Name="ObjInfo" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" />
                </DockPanel>
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Text="Map layers" Margin="0,12,0,4" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                <Button ToolTip="Add layer" Click="OnAddLayer"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" /></Button>
                <Button ToolTip="Delete layer" Click="OnDeleteLayer"><TextBlock Style="{StaticResource Icon}" Text="&#xE738;" /></Button>
                <Button ToolTip="Move layer up" Click="OnLayerUp"><TextBlock Style="{StaticResource Icon}" Text="&#xE70E;" /></Button>
                <Button ToolTip="Move layer down" Click="OnLayerDown"><TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" /></Button>
            </StackPanel>
            <ListBox x:Name="LayersList" SelectionChanged="OnLayerSelected" HorizontalContentAlignment="Stretch" />
        </DockPanel>

        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="#2B2B2B" PreviewMouseWheel="OnWheel" BorderThickness="2" BorderBrush="Transparent"
                      AutomationProperties.Name="Map canvas">
            <Grid x:Name="CanvasHost" Margin="40" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Cross"
                  MouseDown="OnCanvasDown" MouseMove="OnCanvasMove" MouseUp="OnCanvasUp" MouseLeave="OnCanvasLeave">
                <Rectangle Fill="#3A3A3A" />
                <Image x:Name="MapImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <Rectangle x:Name="GridOverlay" IsHitTestVisible="False" />
                <Canvas IsHitTestVisible="False">
                    <Image x:Name="StampPreview" Opacity="0.6" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" Visibility="Collapsed" />
                    <Rectangle x:Name="PickRect" Stroke="Yellow" StrokeThickness="2" StrokeDashArray="3 2" Visibility="Collapsed" />
                </Canvas>
                <Canvas x:Name="ObjectsLayer" IsHitTestVisible="False" />
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
