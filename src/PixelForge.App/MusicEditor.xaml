<UserControl x:Class="PixelForge.App.MusicEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PixelForge.App">
    <UserControl.Resources>
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="BorderThickness" Value="0,0,0,4" />
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button ToolTip="New song (Ctrl+N)" Click="OnNew"><TextBlock Style="{StaticResource Icon}" Text="&#xE7C3;" /></Button>
                <Button ToolTip="Open (Ctrl+O)" Click="OnOpen"><TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" /></Button>
                <Button ToolTip="Save (Ctrl+S)" Click="OnSave"><TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" /></Button>
                <Separator />
                <Button ToolTip="Undo (Ctrl+Z)" Click="OnUndo"><TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" /></Button>
                <Button ToolTip="Redo (Ctrl+Y)" Click="OnRedo"><TextBlock Style="{StaticResource Icon}" Text="&#xE7A6;" /></Button>
                <Separator />
                <Button x:Name="PlaySongBtn" ToolTip="Loop the whole song (Space)" Click="OnPlaySong">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE768;" /><TextBlock Text=" Song" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Button x:Name="PlayPatternBtn" ToolTip="Loop the current pattern" Click="OnPlayPattern">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE768;" /><TextBlock Text=" Pattern" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Button ToolTip="Stop (Space)" Click="OnStop">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" /><TextBlock Text=" Stop" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Separator />
                <Label Content="_BPM" Target="{Binding ElementName=BpmBox}" VerticalAlignment="Center" Padding="4,0,6,0" />
                <TextBox x:Name="BpmBox" AutomationProperties.Name="Tempo in beats per minute" Width="64" VerticalAlignment="Center" ToolTip="Tempo 20 to 400 (Enter to apply)" KeyDown="OnBpmKey" LostKeyboardFocus="OnBpmCommit" />
            </ToolBar>
        </ToolBarTray>
        <Border DockPanel.Dock="Bottom" Padding="10,4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}">
            <TextBlock x:Name="Status" />
        </Border>

        <ScrollViewer DockPanel.Dock="Left" Width="170" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4,4,12,4">
            <TextBlock Text="Channel" FontWeight="SemiBold" Margin="2,0,0,4" />
            <RadioButton x:Name="Ch0" Content="Pulse 1  1" ToolTip="Pulse 1 (key 1)" GroupName="ch" IsChecked="True" Click="OnChannel" />
            <RadioButton x:Name="Ch1" Content="Pulse 2  2" ToolTip="Pulse 2 (key 2)" GroupName="ch" Click="OnChannel" />
            <RadioButton x:Name="Ch2" Content="Triangle  3" ToolTip="Triangle, for bass (key 3)" GroupName="ch" Click="OnChannel" />
            <RadioButton x:Name="Ch3" Content="Noise  4" ToolTip="Noise, for drums (key 4)" GroupName="ch" Click="OnChannel" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" FontSize="11" Margin="2,8,2,0"
                       Text="Click: add a note. Drag right: longer. Click it again or right-click: remove. Vol lane: loudness. F1 lists the keyboard keys." />
            <TextBlock Text="Instrument" FontWeight="SemiBold" Margin="2,12,0,4" />
            <StackPanel x:Name="InstrumentPanel" />
        </StackPanel>
        </ScrollViewer>

        <DockPanel DockPanel.Dock="Top" Margin="4">
            <TextBlock Text="Patterns" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
            <Button ToolTip="New empty pattern" Click="OnAddPattern"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" /></Button>
            <Button ToolTip="Duplicate pattern" Click="OnDuplicatePattern" Margin="2,0"><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" /></Button>
            <Button ToolTip="Delete pattern" Click="OnDeletePattern"><TextBlock Style="{StaticResource Icon}" Text="&#xE738;" /></Button>
            <TextBox x:Name="OrderBox" AutomationProperties.Name="Pattern play order" Width="220" VerticalAlignment="Center" DockPanel.Dock="Right" ToolTip="Pattern numbers in play order, e.g. 1 1 2 1 (Enter to apply)"
                     KeyDown="OnOrderKey" LostKeyboardFocus="OnOrderCommit" />
            <Label Content="_Order" Target="{Binding ElementName=OrderBox}" VerticalAlignment="Center" Padding="12,0,6,0" DockPanel.Dock="Right" />
            <ListBox x:Name="PatternsList" Margin="6,0" SelectionChanged="OnPatternSelected" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </DockPanel>

        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource Bg0Brush}">
            <local:StepGrid x:Name="StepsGrid" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Cursor="Hand" Focusable="True"
                            KeyDown="OnGridKey"
                            MouseDown="OnGridDown" MouseMove="OnGridMove" MouseUp="OnGridUp" />
        </ScrollViewer>
    </DockPanel>
</UserControl>
