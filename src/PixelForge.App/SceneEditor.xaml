<UserControl x:Class="PixelForge.App.SceneEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <UserControl.Resources>
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button ToolTip="New scene (Ctrl+N)" Click="OnNew"><TextBlock Style="{StaticResource Icon}" Text="&#xE7C3;" /></Button>
                <Button ToolTip="Open (Ctrl+O)" Click="OnOpen"><TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" /></Button>
                <Button ToolTip="Save (Ctrl+S)" Click="OnSave"><TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" /></Button>
                <Separator />
                <Button ToolTip="Undo (Ctrl+Z)" Click="OnUndo"><TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" /></Button>
                <Button ToolTip="Redo (Ctrl+Y)" Click="OnRedo"><TextBlock Style="{StaticResource Icon}" Text="&#xE7A6;" /></Button>
                <Separator />
                <Button ToolTip="Zoom out (Ctrl+-)" Click="OnZoomOut"><TextBlock Style="{StaticResource Icon}" Text="&#xE71F;" /></Button>
                <TextBlock x:Name="ZoomText" Width="52" TextAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Zoom level" />
                <Button ToolTip="Zoom in (Ctrl+=)" Click="OnZoomIn"><TextBlock Style="{StaticResource Icon}" Text="&#xE8A3;" /></Button>
                <Button ToolTip="Fit to window (Ctrl+0)" Click="OnZoomFit"><TextBlock Style="{StaticResource Icon}" Text="&#xE9A6;" /></Button>
                <Separator />
                <CheckBox x:Name="SnapToggle" Content="Snap" IsChecked="True" ToolTip="Snap to the project's tile size (Shift while dragging = free)" />
                <ToggleButton x:Name="PlayBtn" Content="▶ Play" Click="OnPlay" ToolTip="Animate sprites and movement tracks (Space)" />
                <Button Content="▶ Game preview" Click="OnGamePreview" ToolTip="Play the scene with the player character (F5)" />
                <Button Content="Check scene…" Click="OnCheck" ToolTip="Missing assets, objects outside, spawn points inside walls, overlaps" />
            </ToolBar>
        </ToolBarTray>
        <Border DockPanel.Dock="Bottom" Padding="10,4" BorderThickness="0,1,0,0" BorderBrush="#3A3A3A">
            <TextBlock x:Name="Status" />
        </Border>

        <!-- tools -->
        <StackPanel x:Name="ToolsPanel" DockPanel.Dock="Left" Width="96" Margin="4">
            <RadioButton x:Name="SelectTool" Content="Select  V" ToolTip="Select and drag objects (V). Del removes, arrows nudge." IsChecked="True" GroupName="scenetool" />
            <RadioButton x:Name="PlaceTool" Content="Place  I" ToolTip="Click to place the asset chosen on the right (I)" GroupName="scenetool" />
            <RadioButton x:Name="AreaTool" Content="Area  A" ToolTip="Drag to draw a trigger, checkpoint, spawn, camera or kill area (A)" GroupName="scenetool" />
            <RadioButton x:Name="CameraTool" Content="Camera  C" ToolTip="Click where the camera starts (C)" GroupName="scenetool" />
        </StackPanel>

        <!-- scene + layers -->
        <ScrollViewer DockPanel.Dock="Left" Width="240" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4,4,10,4">
                <TextBlock Text="Scene" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBox x:Name="WidthBox" Width="64" AutomationProperties.Name="Scene width in pixels" ToolTip="Width (px)" />
                    <TextBlock Text=" × " VerticalAlignment="Center" />
                    <TextBox x:Name="HeightBox" Width="64" AutomationProperties.Name="Scene height in pixels" ToolTip="Height (px)" />
                    <Button Content="Set" Margin="4,0,0,0" Click="OnApplySize" />
                </StackPanel>
                <Label Content="_Level group and order" Target="{Binding ElementName=LevelBox}" Padding="0" Margin="0,6,0,0" />
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="LevelBox" Width="140" LostKeyboardFocus="OnSceneFieldCommit" />
                    <TextBox x:Name="OrderBox" Width="44" Margin="4,0,0,0" AutomationProperties.Name="Order in the level group" LostKeyboardFocus="OnSceneFieldCommit" />
                </StackPanel>
                <Label Content="_Background (hex)" Target="{Binding ElementName=BackgroundBox}" Padding="0" Margin="0,6,0,0" />
                <TextBox x:Name="BackgroundBox" LostKeyboardFocus="OnSceneFieldCommit" />
                <Label Content="_Music" Target="{Binding ElementName=MusicBox}" Padding="0" Margin="0,6,0,0" />
                <ComboBox x:Name="MusicBox" SelectionChanged="OnMusicChanged" />
                <Label Content="_UI over the game" Target="{Binding ElementName=UiBox}" Padding="0" Margin="0,6,0,0" />
                <ComboBox x:Name="UiBox" SelectionChanged="OnUiChanged" ToolTip="A UI kit screen (HUD, menu) drawn over the game in the preview and in exports" />
                <ComboBox x:Name="UiScreenBox" Margin="0,4,0,0" SelectionChanged="OnUiChanged" AutomationProperties.Name="UI screen" />
                <Label Content="Camera mo_tion" Target="{Binding ElementName=CameraClipBox}" Padding="0" Margin="0,6,0,0" />
                <ComboBox x:Name="CameraClipBox" SelectionChanged="OnCameraClipChanged" ToolTip="A clip from an animation library (Motion mode) added to the camera: shakes, pans" />

                <TextBlock Text="Layers (top = front)" FontWeight="SemiBold" Margin="0,12,0,4" />
                <ListBox x:Name="LayersList" Height="150" SelectionChanged="OnLayerSelected" AutomationProperties.Name="Scene layers" />
                <WrapPanel Margin="0,4,0,0">
                    <Button Content="+ Map" Click="OnAddMapLayer" ToolTip="Tilemap layer" Margin="0,0,4,4" />
                    <Button Content="+ Image" Click="OnAddImageLayer" ToolTip="Picture layer (backgrounds, parallax)" Margin="0,0,4,4" />
                    <Button Content="+ Objects" Click="OnAddObjectLayer" ToolTip="Layer for sprites and characters" Margin="0,0,4,4" />
                </WrapPanel>
                <WrapPanel>
                    <Button ToolTip="Move layer to front" Click="OnLayerUp" Margin="0,0,4,0"><TextBlock Style="{StaticResource Icon}" Text="&#xE70E;" /></Button>
                    <Button ToolTip="Move layer to back" Click="OnLayerDown" Margin="0,0,4,0"><TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" /></Button>
                    <Button ToolTip="Delete layer" Click="OnDeleteLayer"><TextBlock Style="{StaticResource Icon}" Text="&#xE738;" /></Button>
                </WrapPanel>
                <StackPanel x:Name="LayerProps" Margin="0,8,0,0">
                    <Label Content="Layer _name" Target="{Binding ElementName=LayerNameBox}" Padding="0" />
                    <TextBox x:Name="LayerNameBox" LostKeyboardFocus="OnLayerFieldCommit" />
                    <Label Content="Asset" Padding="0" Margin="0,4,0,0" />
                    <ComboBox x:Name="LayerAssetBox" SelectionChanged="OnLayerAssetChanged" AutomationProperties.Name="Layer asset" />
                    <TextBlock Text="Parallax X, Y (1 = with the world)" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="ParallaxXBox" Width="60" AutomationProperties.Name="Parallax X" LostKeyboardFocus="OnLayerFieldCommit" />
                        <TextBox x:Name="ParallaxYBox" Width="60" Margin="4,0,0,0" AutomationProperties.Name="Parallax Y" LostKeyboardFocus="OnLayerFieldCommit" />
                    </StackPanel>
                    <TextBlock Text="Offset X, Y (px)" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="OffsetXBox" Width="60" AutomationProperties.Name="Layer offset X" LostKeyboardFocus="OnLayerFieldCommit" />
                        <TextBox x:Name="OffsetYBox" Width="60" Margin="4,0,0,0" AutomationProperties.Name="Layer offset Y" LostKeyboardFocus="OnLayerFieldCommit" />
                    </StackPanel>
                    <CheckBox x:Name="RepeatXBox" Content="Repeat across the scene" Margin="0,4,0,0" Click="OnLayerFieldCommit" />
                    <CheckBox x:Name="LayerVisibleBox" Content="Visible" Margin="0,2,0,0" Click="OnLayerFieldCommit" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- assets to place + selection properties -->
        <ScrollViewer DockPanel.Dock="Right" Width="260" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8,4,8,4">
                <TextBlock Text="Place" FontWeight="SemiBold" />
                <ListBox x:Name="PlaceList" Height="160" AutomationProperties.Name="Sprites and characters to place" SelectionChanged="OnPlaceChosen" />
                <Label Content="New area _kind" Target="{Binding ElementName=AreaKindBox}" Padding="0" Margin="0,6,0,0" />
                <ComboBox x:Name="AreaKindBox" />
                <TextBlock x:Name="SelectionTitle" FontWeight="SemiBold" Margin="0,12,0,4" Text="Nothing selected" />
                <StackPanel x:Name="SelectionProps" Visibility="Collapsed">
                    <Label Content="Na_me" Target="{Binding ElementName=SelNameBox}" Padding="0" />
                    <TextBox x:Name="SelNameBox" LostKeyboardFocus="OnSelCommit" />
                    <TextBlock Text="X, Y (W, H for areas)" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="SelXBox" Width="52" AutomationProperties.Name="X" LostKeyboardFocus="OnSelCommit" />
                        <TextBox x:Name="SelYBox" Width="52" Margin="4,0,0,0" AutomationProperties.Name="Y" LostKeyboardFocus="OnSelCommit" />
                        <TextBox x:Name="SelWBox" Width="52" Margin="4,0,0,0" AutomationProperties.Name="Width" LostKeyboardFocus="OnSelCommit" />
                        <TextBox x:Name="SelHBox" Width="52" Margin="4,0,0,0" AutomationProperties.Name="Height" LostKeyboardFocus="OnSelCommit" />
                    </StackPanel>
                    <StackPanel x:Name="InstanceProps">
                        <Label Content="Ani_mation" Target="{Binding ElementName=AnimBox}" Padding="0" Margin="0,4,0,0" />
                        <ComboBox x:Name="AnimBox" SelectionChanged="OnAnimChanged" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <CheckBox x:Name="FlipBox" Content="Flip" Click="OnSelCommit" />
                            <TextBlock Text="  Z " VerticalAlignment="Center" />
                            <TextBox x:Name="ZBox" Width="44" AutomationProperties.Name="Draw order" LostKeyboardFocus="OnSelCommit" />
                        </StackPanel>
                        <Label Content="Movement _track: time x y [scaleX scaleY rotation opacity easing]" Target="{Binding ElementName=TrackBox}" Padding="0" Margin="0,6,0,0" />
                        <TextBox x:Name="TrackBox" AcceptsReturn="True" MinHeight="70" FontFamily="Consolas" LostKeyboardFocus="OnSelCommit"
                                 ToolTip="One key per line, e.g. 0 0 0 then 2000 64 0 EaseInOut. Offsets are relative to X, Y." />
                        <CheckBox x:Name="LoopBox" Content="Loop track" IsChecked="True" Click="OnSelCommit" />
                        <Label Content="Motion _clip (replaces the track)" Target="{Binding ElementName=ClipBox}" Padding="0" Margin="0,6,0,0" />
                        <ComboBox x:Name="ClipBox" SelectionChanged="OnClipChanged" />
                        <Button Content="Save track as clip…" Margin="0,4,0,0" HorizontalAlignment="Left" Click="OnSaveTrackAsClip"
                                ToolTip="Copies the movement track into an animation library, so other objects and scenes can reuse it" />
                    </StackPanel>
                    <StackPanel x:Name="AreaProps">
                        <Label Content="Area k_ind" Target="{Binding ElementName=SelAreaKindBox}" Padding="0" Margin="0,4,0,0" />
                        <ComboBox x:Name="SelAreaKindBox" SelectionChanged="OnSelAreaKind" />
                    </StackPanel>
                    <Label Content="_Properties (key = value)" Target="{Binding ElementName=SelPropsBox}" Padding="0" Margin="0,6,0,0" />
                    <TextBox x:Name="SelPropsBox" AcceptsReturn="True" MinHeight="50" LostKeyboardFocus="OnSelCommit" />
                    <Button Content="Delete" Margin="0,6,0,0" HorizontalAlignment="Left" Click="OnDeleteSelected" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#1E1E1E"
                      PreviewMouseWheel="OnWheel" BorderThickness="2" BorderBrush="Transparent" AutomationProperties.Name="Scene canvas">
            <Canvas x:Name="SceneCanvas" Margin="40" HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="True"
                    MouseDown="OnCanvasDown" MouseMove="OnCanvasMove" MouseUp="OnCanvasUp" Background="Transparent" />
        </ScrollViewer>
    </DockPanel>
</UserControl>
