<UserControl x:Class="PixelForge.App.AudioStudio"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button ToolTip="New mix (Ctrl+N)" Click="OnNew"><TextBlock Style="{StaticResource Icon}" Text="&#xE7C3;" /></Button>
                <Button ToolTip="Open (Ctrl+O)" Click="OnOpen"><TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" /></Button>
                <Button ToolTip="Save (Ctrl+S)" Click="OnSave"><TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" /></Button>
                <Separator />
                <Button ToolTip="Undo (Ctrl+Z)" Click="OnUndo"><TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" /></Button>
                <Button ToolTip="Redo (Ctrl+Y)" Click="OnRedo"><TextBlock Style="{StaticResource Icon}" Text="&#xE7A6;" /></Button>
                <Separator />
                <ToggleButton x:Name="PlayBtn" Content="▶ Play" Click="OnPlay" ToolTip="Play the mix from the playhead (Space)" />
                <CheckBox x:Name="LoopToggle" Content="Loop" ToolTip="Repeat the loop region while playing (L)" />
                <Separator />
                <Button ToolTip="Zoom out (Ctrl+-)" Click="OnZoomOut"><TextBlock Style="{StaticResource Icon}" Text="&#xE71F;" /></Button>
                <Button ToolTip="Zoom in (Ctrl+=)" Click="OnZoomIn"><TextBlock Style="{StaticResource Icon}" Text="&#xE8A3;" /></Button>
                <Separator />
                <Button Content="Export WAV…" Click="OnExportWav" ToolTip="Render the mix to a 16-bit WAV file" />
            </ToolBar>
        </ToolBarTray>
        <Border DockPanel.Dock="Bottom" Padding="10,4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}">
            <TextBlock x:Name="Status" />
        </Border>

        <!-- library + playlists -->
        <ScrollViewer DockPanel.Dock="Left" Width="250" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4,4,10,4">
                <Label Content="_Library (project audio)" Target="{Binding ElementName=LibraryList}" Padding="0" FontWeight="SemiBold" />
                <ListBox x:Name="LibraryList" Height="220" Margin="0,4,0,0" MouseDoubleClick="OnLibraryDouble"
                         ToolTip="Songs, sounds, WAV files and mixes in the project. Double-click or Enter adds to the selected track at the playhead. Import WAV files with the asset browser." KeyDown="OnLibraryKey" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="Preview" Click="OnLibraryPreview" Margin="0,0,4,0" />
                    <Button Content="Add to track" Click="OnLibraryAdd" />
                </StackPanel>

                <TextBlock Text="Playlists" FontWeight="SemiBold" Margin="0,16,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <ComboBox x:Name="PlaylistBox" Width="130" SelectionChanged="OnPlaylistChosen" AutomationProperties.Name="Playlist" />
                    <Button Content="New" Click="OnPlaylistNew" Margin="4,0,0,0" />
                    <Button Content="Rename" Click="OnPlaylistRename" Margin="4,0,0,0" />
                </StackPanel>
                <ListBox x:Name="PlaylistItems" Height="140" Margin="0,4,0,0" AutomationProperties.Name="Playlist items in play order" />
                <WrapPanel Margin="0,4,0,0">
                    <Button Content="Add library item" Click="OnPlaylistAdd" Margin="0,0,4,4" />
                    <Button Content="Remove" Click="OnPlaylistRemove" Margin="0,0,4,4" />
                    <Button Content="Up" Click="OnPlaylistUp" Margin="0,0,4,4" />
                    <Button Content="Down" Click="OnPlaylistDown" Margin="0,0,4,4" />
                    <Button Content="Delete playlist" Click="OnPlaylistDelete" Margin="0,0,4,4" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="PlaylistLoop" Content="Loop" Click="OnPlaylistFlags" Margin="0,0,12,0" />
                    <CheckBox x:Name="PlaylistShuffle" Content="Shuffle in game" Click="OnPlaylistFlags" />
                </StackPanel>
                <Button Content="▶ Play playlist" Click="OnPlaylistPlay" HorizontalAlignment="Left" Margin="0,4,0,0" ToolTip="Each item once, in order" />
            </StackPanel>
        </ScrollViewer>

        <!-- properties -->
        <ScrollViewer DockPanel.Dock="Right" Width="250" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10,4,4,4">
                <TextBlock Text="Mix" FontWeight="SemiBold" />
                <Label Content="_Master volume" Target="{Binding ElementName=MasterBox}" Padding="0" Margin="0,4,0,0" />
                <Slider x:Name="MasterBox" Minimum="0" Maximum="2" SmallChange="0.05" LargeChange="0.25" ValueChanged="OnMasterChanged" />
                <Label Content="Loop region (ms): start, end" Padding="0" Margin="0,6,0,0" />
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="LoopStartBox" Width="80" AutomationProperties.Name="Loop start in milliseconds" LostKeyboardFocus="OnLoopCommit" />
                    <TextBox x:Name="LoopEndBox" Width="80" Margin="4,0,0,0" AutomationProperties.Name="Loop end in milliseconds" LostKeyboardFocus="OnLoopCommit" />
                </StackPanel>
                <TextBlock Text="Leave both empty for no loop." Foreground="{DynamicResource MutedText}" FontSize="11" />

                <TextBlock Text="Track" FontWeight="SemiBold" Margin="0,16,0,0" />
                <Label Content="_Name" Target="{Binding ElementName=TrackNameBox}" Padding="0" Margin="0,4,0,0" />
                <TextBox x:Name="TrackNameBox" LostKeyboardFocus="OnTrackCommit" />
                <Label Content="_Volume" Target="{Binding ElementName=TrackVolumeBox}" Padding="0" Margin="0,4,0,0" />
                <Slider x:Name="TrackVolumeBox" Minimum="0" Maximum="2" SmallChange="0.05" LargeChange="0.25" ValueChanged="OnTrackVolume" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <CheckBox x:Name="MuteBox" Content="Mute" Click="OnTrackCommit" Margin="0,0,12,0" />
                    <CheckBox x:Name="SoloBox" Content="Solo" Click="OnTrackCommit" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="Add track" Click="OnAddTrack" Margin="0,0,4,0" />
                    <Button Content="Delete track" Click="OnDeleteTrack" />
                </StackPanel>

                <StackPanel x:Name="ClipProps">
                    <TextBlock x:Name="ClipTitle" FontWeight="SemiBold" Margin="0,16,0,0" TextWrapping="Wrap" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <Label Content="_Start (ms)" Target="{Binding ElementName=ClipStartBox}" Padding="0" VerticalAlignment="Center" />
                        <TextBox x:Name="ClipStartBox" Grid.Column="1" Margin="0,2" LostKeyboardFocus="OnClipCommit" />
                        <Label Grid.Row="1" Content="Cut: s_kip (ms)" Target="{Binding ElementName=ClipOffsetBox}" Padding="0" VerticalAlignment="Center" />
                        <TextBox x:Name="ClipOffsetBox" Grid.Row="1" Grid.Column="1" Margin="0,2" LostKeyboardFocus="OnClipCommit" />
                        <Label Grid.Row="2" Content="Cut: _keep (ms)" Target="{Binding ElementName=ClipLengthBox}" Padding="0" VerticalAlignment="Center" />
                        <TextBox x:Name="ClipLengthBox" Grid.Row="2" Grid.Column="1" Margin="0,2" LostKeyboardFocus="OnClipCommit" ToolTip="Empty = to the end of the source" />
                        <Label Grid.Row="3" Content="_Gain" Target="{Binding ElementName=ClipGainBox}" Padding="0" VerticalAlignment="Center" />
                        <TextBox x:Name="ClipGainBox" Grid.Row="3" Grid.Column="1" Margin="0,2" LostKeyboardFocus="OnClipCommit" ToolTip="1 = unchanged, 0.5 = half" />
                        <Label Grid.Row="4" Content="Fade _in (ms)" Target="{Binding ElementName=ClipFadeInBox}" Padding="0" VerticalAlignment="Center" />
                        <TextBox x:Name="ClipFadeInBox" Grid.Row="4" Grid.Column="1" Margin="0,2" LostKeyboardFocus="OnClipCommit" />
                        <Label Grid.Row="5" Content="Fade _out (ms)" Target="{Binding ElementName=ClipFadeOutBox}" Padding="0" VerticalAlignment="Center" />
                        <TextBox x:Name="ClipFadeOutBox" Grid.Row="5" Grid.Column="1" Margin="0,2" LostKeyboardFocus="OnClipCommit" />
                        <Label Grid.Row="6" Content="_Repeat" Target="{Binding ElementName=ClipRepeatBox}" Padding="0" VerticalAlignment="Center" />
                        <TextBox x:Name="ClipRepeatBox" Grid.Row="6" Grid.Column="1" Margin="0,2" LostKeyboardFocus="OnClipCommit" ToolTip="Play the cut part this many times" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Join to previous" Click="OnJoinPrevious" ToolTip="Move this clip to start where the previous clip on the track ends, overlapping by the crossfade" />
                        <TextBox x:Name="CrossfadeBox" Width="50" Margin="4,0,0,0" Text="0" AutomationProperties.Name="Crossfade in milliseconds" ToolTip="Crossfade (ms)" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Split at playhead" Click="OnSplit" Margin="0,0,4,0" ToolTip="Cut the clip in two at the playhead (S)" />
                        <Button Content="Delete clip" Click="OnDeleteClip" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- timeline -->
        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" BorderThickness="2" BorderBrush="Transparent">
            <Canvas x:Name="Timeline" Background="{DynamicResource Bg0Brush}" HorizontalAlignment="Left" VerticalAlignment="Top" Focusable="True"
                    AutomationProperties.Name="Timeline. Click to place the playhead or select a clip; drag clips; arrows move the selected clip, Up and Down change track, brackets select the previous or next clip."
                    MouseLeftButtonDown="OnTimelineDown" MouseMove="OnTimelineMove" MouseLeftButtonUp="OnTimelineUp" />
        </ScrollViewer>
    </DockPanel>
</UserControl>
