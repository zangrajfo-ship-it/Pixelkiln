<UserControl x:Class="PixelForge.App.TextureEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PixelForge.App"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <UserControl.Resources>
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="8,2" />
        </Style>
        <Style x:Key="Field" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button ToolTip="New texture (Ctrl+N)" Click="OnNew"><TextBlock Style="{StaticResource Icon}" Text="&#xE7C3;" /></Button>
                <Button ToolTip="Open (Ctrl+O)" Click="OnOpen"><TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" /></Button>
                <Button ToolTip="Save (Ctrl+S)" Click="OnSave"><TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" /></Button>
                <Separator />
                <Button ToolTip="Undo (Ctrl+Z)" Click="OnUndo"><TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" /></Button>
                <Button ToolTip="Redo (Ctrl+Y)" Click="OnRedo"><TextBlock Style="{StaticResource Icon}" Text="&#xE7A6;" /></Button>
                <Separator />
                <Button Content="Export maps…" Click="OnExport" ToolTip="Colour, normal, height and occlusion PNGs (Ctrl+E)" />
                <Button x:Name="PaintButton" Content="Paint it…" Click="OnPaint" ToolTip="Open the texture's painting in Paint mode with wrap-around strokes (or make a new painting)" />
            </ToolBar>
        </ToolBarTray>
        <Border DockPanel.Dock="Bottom" Padding="10,4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}">
            <TextBlock x:Name="Status" />
        </Border>

        <ScrollViewer DockPanel.Dock="Left" Width="280" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8,4,10,4">
                <Label Content="_Source" Target="{Binding ElementName=SourceBox}" Padding="0" FontWeight="SemiBold" />
                <ComboBox x:Name="SourceBox" Margin="0,4,0,0" SelectionChanged="OnFieldChanged" />

                <StackPanel x:Name="ProceduralPanel">
                    <Label Content="_Material" Target="{Binding ElementName=MaterialBox}" Padding="0" Margin="0,8,0,0" />
                    <ComboBox x:Name="MaterialBox" SelectionChanged="OnFieldChanged" />
                    <Label Content="S_eed (number or word)" Target="{Binding ElementName=SeedBox}" Padding="0" Margin="0,8,0,0" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Shuffle" Click="OnShuffle" Margin="4,0,0,0" ToolTip="A random seed" />
                        <TextBox x:Name="SeedBox" LostKeyboardFocus="OnFieldChanged" />
                    </DockPanel>
                    <Label Content="Si_ze (px)" Target="{Binding ElementName=SizeBox}" Padding="0" Margin="0,8,0,0" />
                    <ComboBox x:Name="SizeBox" SelectionChanged="OnFieldChanged" />
                    <TextBlock x:Name="ScaleLabel" Style="{StaticResource Field}" />
                    <Slider x:Name="ScaleSlider" Minimum="1" Maximum="24" SmallChange="1" LargeChange="2" IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.Name="Features per tile" />
                    <TextBlock x:Name="DetailLabel" Style="{StaticResource Field}" />
                    <Slider x:Name="DetailSlider" Minimum="1" Maximum="6" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.Name="Noise detail" />
                    <TextBlock Text="Colours" Style="{StaticResource Field}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <RadioButton x:Name="EditDark" Content="Dark" IsChecked="True" GroupName="texcolor" Click="OnColorTarget" />
                        <RadioButton x:Name="EditLight" Content="Light" GroupName="texcolor" Click="OnColorTarget" />
                    </StackPanel>
                    <local:ColorPicker x:Name="Picker" Margin="0,6,0,0" />
                </StackPanel>

                <StackPanel x:Name="AssetPanel" Visibility="Collapsed">
                    <Label Content="_Painting or picture" Target="{Binding ElementName=AssetBox}" Padding="0" Margin="0,8,0,0" />
                    <ComboBox x:Name="AssetBox" SelectionChanged="OnFieldChanged" />
                    <TextBlock x:Name="SeamLabel" Style="{StaticResource Field}" />
                    <Slider x:Name="SeamSlider" Minimum="0" Maximum="128" SmallChange="1" LargeChange="8" AutomationProperties.Name="Seam blend width" />
                </StackPanel>

                <TextBlock Text="Maps" FontWeight="SemiBold" Margin="0,16,0,0" />
                <TextBlock x:Name="NormalLabel" Style="{StaticResource Field}" />
                <Slider x:Name="NormalSlider" Minimum="0" Maximum="10" SmallChange="0.25" LargeChange="1" AutomationProperties.Name="Normal strength" />
                <CheckBox x:Name="FlipGreenBox" Content="Green down (DirectX normal maps)" Margin="0,6,0,0" Click="OnFieldChanged" />
                <TextBlock x:Name="AoLabel" Style="{StaticResource Field}" />
                <Slider x:Name="AoSlider" Minimum="0" Maximum="4" SmallChange="0.1" LargeChange="0.5" AutomationProperties.Name="Occlusion strength" />
            </StackPanel>
        </ScrollViewer>

        <DockPanel Margin="8">
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <RadioButton x:Name="ViewAlbedo" Content="Colour" IsChecked="True" GroupName="texview" Click="OnViewChanged" />
                <RadioButton x:Name="ViewHeight" Content="Height" GroupName="texview" Click="OnViewChanged" />
                <RadioButton x:Name="ViewNormal" Content="Normal" GroupName="texview" Click="OnViewChanged" />
                <RadioButton x:Name="ViewAo" Content="Occlusion" GroupName="texview" Click="OnViewChanged" />
                <RadioButton x:Name="ViewLit" Content="Lit" GroupName="texview" Click="OnViewChanged" ToolTip="Colour lit by a light from the angle below, using the normal map" />
                <CheckBox x:Name="RepeatBox" Content="Repeat 4×4" IsChecked="True" Margin="12,0,0,0" VerticalAlignment="Center" Click="OnViewChanged" />
                <TextBlock Text="Light" Margin="12,0,6,0" VerticalAlignment="Center" />
                <Slider x:Name="LightSlider" Width="140" Minimum="0" Maximum="360" Value="225" VerticalAlignment="Center" AutomationProperties.Name="Light direction" />
            </WrapPanel>
            <Border Background="{DynamicResource Bg0Brush}" SizeChanged="OnPreviewSize">
                <Rectangle x:Name="PreviewRect" AutomationProperties.Name="Texture preview" />
            </Border>
        </DockPanel>
    </DockPanel>
</UserControl>
