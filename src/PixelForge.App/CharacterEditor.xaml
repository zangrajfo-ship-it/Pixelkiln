<UserControl x:Class="PixelForge.App.CharacterEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button ToolTip="New character (Ctrl+N)" Click="OnNew"><TextBlock Style="{StaticResource Icon}" Text="&#xE7C3;" /></Button>
                <Button ToolTip="Open (Ctrl+O)" Click="OnOpen"><TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" /></Button>
                <Button ToolTip="Save (Ctrl+S)" Click="OnSave"><TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" /></Button>
                <Separator />
                <Button ToolTip="Undo (Ctrl+Z)" Click="OnUndo"><TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" /></Button>
                <Button ToolTip="Redo (Ctrl+Y)" Click="OnRedo"><TextBlock Style="{StaticResource Icon}" Text="&#xE7A6;" /></Button>
                <Separator />
                <Button Content="Add standard states" Click="OnTemplate" ToolTip="Adds idle, walk, run, jump, attack, hurt and death tags to the sprite where missing" />
                <Button Content="Export JSON…" Click="OnExport" ToolTip="Character JSON + sprite sheet PNG for a game" />
            </ToolBar>
        </ToolBarTray>
        <Border DockPanel.Dock="Bottom" Padding="10,4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}">
            <TextBlock x:Name="Status" />
        </Border>

        <!-- left: what the character is -->
        <ScrollViewer DockPanel.Dock="Left" Width="250" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8">
                <Label Content="_Sprite" Target="{Binding ElementName=SpriteBox}" Padding="0" />
                <ComboBox x:Name="SpriteBox" SelectionChanged="OnSpriteChosen" Margin="0,2,0,8" ToolTip="Sprite asset of the open project" />
                <Label Content="_Kind" Target="{Binding ElementName=KindBox}" Padding="0" />
                <ComboBox x:Name="KindBox" SelectionChanged="OnKindChanged" Margin="0,2,0,8" />
                <Label Content="_Facing (as drawn)" Target="{Binding ElementName=FacingBox}" Padding="0" />
                <ComboBox x:Name="FacingBox" SelectionChanged="OnFacingChanged" Margin="0,2,0,8" />
                <TextBlock Text="Origin (Alt+click in the preview)" />
                <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                    <TextBox x:Name="OriginXBox" Width="60" AutomationProperties.Name="Origin X" LostKeyboardFocus="OnOriginCommit" KeyDown="OnFieldKey" />
                    <TextBox x:Name="OriginYBox" Width="60" Margin="6,0,0,0" AutomationProperties.Name="Origin Y" LostKeyboardFocus="OnOriginCommit" KeyDown="OnFieldKey" />
                </StackPanel>
                <TextBlock Text="States → sprite tags" FontWeight="SemiBold" Margin="0,4,0,4" />
                <StackPanel x:Name="StatesPanel" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                    <Button Content="Add state…" Click="OnAddState" Margin="0,0,4,0" />
                    <Button Content="Remove" Click="OnRemoveState" ToolTip="Removes the state shown in the preview" />
                </StackPanel>
                <Label Content="_Properties (key = value per line)" Target="{Binding ElementName=PropsBox}" Padding="0" />
                <TextBox x:Name="PropsBox" AcceptsReturn="True" MinHeight="70" TextWrapping="NoWrap" LostKeyboardFocus="OnPropsCommit"
                         ToolTip="Game data passed to exports, e.g. hp = 3" />
            </StackPanel>
        </ScrollViewer>

        <!-- right: boxes -->
        <DockPanel DockPanel.Dock="Right" Width="260" Margin="8">
            <TextBlock DockPanel.Dock="Top" Text="Boxes" FontWeight="SemiBold" />
            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedText}" Margin="0,2,0,6"
                       Text="Drag in the preview to draw a box. Click a box to select it; arrows move it, Shift+arrows resize, Del removes." />
            <StackPanel DockPanel.Dock="Top">
                <Label Content="New box _kind" Target="{Binding ElementName=BoxKindBox}" Padding="0" />
                <ComboBox x:Name="BoxKindBox" Margin="0,2,0,4" />
                <Label Content="_Collision category" Target="{Binding ElementName=CategoryBox}" Padding="0" />
                <ComboBox x:Name="CategoryBox" Margin="0,2,0,4" />
                <CheckBox x:Name="ThisFrameOnly" Content="Only this frame" Margin="0,2,0,2" />
                <CheckBox x:Name="ThisStateOnly" Content="Only this state" IsChecked="True" Margin="0,2,0,8" />
            </StackPanel>
            <ListBox x:Name="BoxList" SelectionChanged="OnBoxSelected" AutomationProperties.Name="Boxes of the character" />
        </DockPanel>

        <!-- center: preview -->
        <DockPanel Margin="4">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <Label Content="S_tate" Target="{Binding ElementName=StateBox}" Padding="0,0,6,0" VerticalAlignment="Center" />
                <ComboBox x:Name="StateBox" Width="120" SelectionChanged="OnStateChanged" />
                <ToggleButton x:Name="PlayBtn" Content="▶ Play" Margin="8,0,0,0" Click="OnPlay" ToolTip="Play the state (Space)" />
                <Label Content="Spee_d" Target="{Binding ElementName=SpeedBox}" Padding="8,0,6,0" VerticalAlignment="Center" />
                <ComboBox x:Name="SpeedBox" Width="80" SelectionChanged="OnSpeedChanged" />
                <Label Content="T_hen" Target="{Binding ElementName=ThenBox}" Padding="8,0,6,0" VerticalAlignment="Center" />
                <ComboBox x:Name="ThenBox" Width="110" ToolTip="Transition preview: after one pass of the state, play this one" />
            </StackPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <TextBlock x:Name="FrameText" DockPanel.Dock="Right" Width="90" TextAlignment="Right" VerticalAlignment="Center" />
                <Slider x:Name="FrameSlider" Minimum="0" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnFrameSlider"
                        AutomationProperties.Name="Frame in the state" />
            </DockPanel>
            <ScrollViewer x:Name="PreviewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource Bg0Brush}">
                <Grid x:Name="PreviewHost" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Cursor="Cross" Focusable="True"
                      AutomationProperties.Name="Character preview"
                      MouseLeftButtonDown="OnPreviewDown" MouseMove="OnPreviewMove" MouseLeftButtonUp="OnPreviewUp" KeyDown="OnPreviewKey">
                    <Rectangle x:Name="PreviewChecker" />
                    <Image x:Name="PreviewImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <Canvas x:Name="BoxLayer" IsHitTestVisible="False" />
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </DockPanel>
</UserControl>
