<UserControl x:Class="PixelForge.App.SpriteEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PixelForge.App"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <UserControl.Resources>
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button ToolTip="New sprite (Ctrl+N)" Click="OnNew"><TextBlock Style="{StaticResource Icon}" Text="&#xE7C3;" /></Button>
                <Button ToolTip="Open (Ctrl+O)" Click="OnOpen"><TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" /></Button>
                <Button ToolTip="Save (Ctrl+S)" Click="OnSave"><TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" /></Button>
                <Separator />
                <Button ToolTip="Undo (Ctrl+Z)" Click="OnUndo"><TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" /></Button>
                <Button ToolTip="Redo (Ctrl+Y)" Click="OnRedo"><TextBlock Style="{StaticResource Icon}" Text="&#xE7A6;" /></Button>
                <Separator />
                <Button ToolTip="Zoom out (Ctrl+-)" Click="OnZoomOut"><TextBlock Style="{StaticResource Icon}" Text="&#xE71F;" /></Button>
                <TextBlock x:Name="ZoomText" Width="52" TextAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Zoom level" />
                <Button ToolTip="Zoom in (Ctrl+=)" Click="OnZoomIn"><TextBlock Style="{StaticResource Icon}" Text="&#xE8A3;" /></Button>
                <Button ToolTip="Fit to window (Ctrl+0)" Click="OnZoomFit"><TextBlock Style="{StaticResource Icon}" Text="&#xE9A6;" /></Button>
                <Separator />
                <CheckBox x:Name="GridToggle" Content="Grid" ToolTip="Pixel grid (Ctrl+G)" IsChecked="True" Click="OnGridToggle" />
                <CheckBox x:Name="TileGridToggle" Content="Tile grid" ToolTip="Grid of tiles, size in View → Tile grid size (Ctrl+Shift+G)" Click="OnGridToggle" />
                <CheckBox x:Name="TiledToggle" Content="Tiled" ToolTip="Tiled mode: shows the sprite repeated and wraps drawing at the edges, for seamless tiles (T)" Click="OnTiledToggle" />
                <Button ToolTip="Preview window (P)" Click="OnPreview"><TextBlock Style="{StaticResource Icon}" Text="&#xE890;" /></Button>
            </ToolBar>
            <ToolBar x:Name="ToolOptionsBar" AutomationProperties.Name="Tool options">
                <TextBlock x:Name="ToolHint" VerticalAlignment="Center" Margin="4,0,12,0" Foreground="{DynamicResource MutedText}" />
                <StackPanel x:Name="SizeOption" Orientation="Horizontal">
                    <Label Content="_Size" Target="{Binding ElementName=SizeBox}" VerticalAlignment="Center" Padding="0,0,6,0" />
                    <ComboBox x:Name="SizeBox" AutomationProperties.Name="Brush size" Width="70" SelectedIndex="0" ToolTip="Brush size  ([ and ])">
                        <ComboBoxItem>1</ComboBoxItem><ComboBoxItem>2</ComboBoxItem><ComboBoxItem>3</ComboBoxItem><ComboBoxItem>4</ComboBoxItem>
                        <ComboBoxItem>5</ComboBoxItem><ComboBoxItem>6</ComboBoxItem><ComboBoxItem>7</ComboBoxItem><ComboBoxItem>8</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
                <CheckBox x:Name="FilledToggle" Content="Filled" ToolTip="Filled rectangles and ellipses" />
                <CheckBox x:Name="PixelPerfectToggle" Content="Pixel-perfect" ToolTip="Removes the extra corner pixels in diagonal strokes (size 1)" IsChecked="True" />
                <CheckBox x:Name="ContiguousToggle" Content="Contiguous" ToolTip="On: only the touching area. Off: every pixel of that color." IsChecked="True" />
                <CheckBox x:Name="MirrorXToggle" Content="Mirror X" ToolTip="Mirror drawing left/right" Click="OnMirrorToggle" />
                <CheckBox x:Name="MirrorYToggle" Content="Mirror Y" ToolTip="Mirror drawing up/down" Click="OnMirrorToggle" />
            </ToolBar>
        </ToolBarTray>
        <Border DockPanel.Dock="Bottom" Padding="10,4" BorderThickness="0,1,0,0" BorderBrush="#3A3A3A">
            <TextBlock x:Name="Status" />
        </Border>

        <StackPanel x:Name="ToolsPanel" DockPanel.Dock="Left" Width="96" Margin="4">
            <RadioButton Tag="Pencil" Content="Pencil  B" ToolTip="Pencil (B)" IsChecked="True" GroupName="tool" Click="OnToolClick" />
            <RadioButton Tag="Eraser" Content="Eraser  E" ToolTip="Eraser (E)" GroupName="tool" Click="OnToolClick" />
            <RadioButton Tag="Fill" Content="Fill  G" ToolTip="Fill (G)" GroupName="tool" Click="OnToolClick" />
            <RadioButton Tag="Picker" Content="Picker  I" ToolTip="Color picker (I)" GroupName="tool" Click="OnToolClick" />
            <RadioButton Tag="Line" Content="Line  L" ToolTip="Line (L). Shift: 45°" GroupName="tool" Click="OnToolClick" />
            <RadioButton Tag="Rect" Content="Rect  U" ToolTip="Rectangle (U). Shift: square" GroupName="tool" Click="OnToolClick" />
            <RadioButton Tag="Ellipse" Content="Ellipse  O" ToolTip="Ellipse (O). Shift: circle" GroupName="tool" Click="OnToolClick" />
            <RadioButton Tag="Select" Content="Select  M" ToolTip="Select (M): drag to select, drag inside to move. Ctrl+C/X/V, Del, H/V flip, R rotate, Enter apply, Esc cancel" GroupName="tool" Click="OnToolClick" />
            <RadioButton Tag="Wand" Content="Wand  W" ToolTip="Magic wand (W): selects pixels of the same color. Shift+click adds. Then use Select (M) to move them." GroupName="tool" Click="OnToolClick" />
            <Grid Height="56" Margin="2,12,2,0" ToolTip="Left/right mouse colors. Click to change.">
                <Button x:Name="SecondarySwatch" Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Template="{StaticResource SwatchTemplate}" BorderBrush="Gray" BorderThickness="1" Click="OnSecondarySwatch" ToolTip="Right mouse color. Click to edit it in the color picker." />
                <Button x:Name="PrimarySwatch" Width="34" Height="34" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Template="{StaticResource SwatchTemplate}" BorderBrush="White" BorderThickness="1" Click="OnPrimarySwatch" ToolTip="Left mouse color. Click to edit it in the color picker." />
            </Grid>
        </StackPanel>

        <DockPanel DockPanel.Dock="Right" Width="232" Margin="4">
            <local:ColorPicker x:Name="Picker" DockPanel.Dock="Top" Margin="0,0,0,10" />
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <Button x:Name="PaletteMenuBtn" DockPanel.Dock="Right" Content="Palette ▾" Click="OnPaletteMenu">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Load palette… (.hex, .gpl)" Click="OnLoadPalette" />
                            <MenuItem Header="Save palette…" Click="OnSavePalette" />
                            <MenuItem Header="Reset to default (DB32)" Click="OnResetPalette" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <TextBlock Text="Left / right click. Alt+click removes." VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" />
            </DockPanel>
            <WrapPanel x:Name="PaletteWrap" DockPanel.Dock="Top" />
            <TextBlock DockPanel.Dock="Top" Text="Layers" Margin="0,12,0,4" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                <Button ToolTip="Add layer" Click="OnAddLayer"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" /></Button>
                <Button ToolTip="Delete layer" Click="OnDeleteLayer"><TextBlock Style="{StaticResource Icon}" Text="&#xE738;" /></Button>
                <Button ToolTip="Move layer up" Click="OnLayerUp"><TextBlock Style="{StaticResource Icon}" Text="&#xE70E;" /></Button>
                <Button ToolTip="Move layer down" Click="OnLayerDown"><TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" /></Button>
            </StackPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <Label Content="_Opacity" Target="{Binding ElementName=OpacitySlider}" Padding="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="OpacityValue" DockPanel.Dock="Right" Width="40" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" />
                <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1"
                        AutomationProperties.Name="Layer opacity in percent" PreviewMouseLeftButtonDown="OnOpacityDragStart" ValueChanged="OnOpacityChanged" />
            </DockPanel>
            <ListBox x:Name="LayersList" SelectionChanged="OnLayerSelected" HorizontalContentAlignment="Stretch" />
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="4">
            <ToolBar DockPanel.Dock="Top">
                <TextBlock Text="Frames" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Button ToolTip="New empty frame" Click="OnAddFrame"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" /></Button>
                <Button ToolTip="Duplicate frame" Click="OnDuplicateFrame"><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" /></Button>
                <Button ToolTip="Delete frame" Click="OnDeleteFrame"><TextBlock Style="{StaticResource Icon}" Text="&#xE738;" /></Button>
                <Button ToolTip="Move frame left" Click="OnFrameLeft"><TextBlock Style="{StaticResource Icon}" Text="&#xE76B;" /></Button>
                <Button ToolTip="Move frame right" Click="OnFrameRight"><TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" /></Button>
                <Label Content="_Duration (ms)" Target="{Binding ElementName=DurationBox}" VerticalAlignment="Center" Padding="8,0,6,0" />
                <TextBox x:Name="DurationBox" AutomationProperties.Name="Frame duration in milliseconds" Width="64" VerticalAlignment="Center" ToolTip="Frame duration in ms (Enter to apply)" KeyDown="OnDurationKey" LostKeyboardFocus="OnDurationCommit" />
                <Separator />
                <CheckBox x:Name="OnionToggle" Content="Onion skin" ToolTip="Show previous and next frame faintly" Click="OnOnionToggle" />
                <Separator />
                <ToggleButton x:Name="PlayBtn" Content="▶ Play" ToolTip="Play animation (Space)" Click="OnPlay" />
            </ToolBar>
            <DockPanel DockPanel.Dock="Top" Margin="0,2,0,2">
                <TextBlock Text="Tags" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,8,0" />
                <Button ToolTip="New tag from the selected frames (Shift+click frames to select several)" Click="OnAddTag"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" /></Button>
                <Button ToolTip="Set the chosen tag to the selected frames" Click="OnSetTagRange"><TextBlock Style="{StaticResource Icon}" Text="&#xE8B3;" /></Button>
                <Button ToolTip="Rename the chosen tag" Click="OnRenameTag"><TextBlock Style="{StaticResource Icon}" Text="&#xE8AC;" /></Button>
                <Button ToolTip="Delete the chosen tag" Click="OnDeleteTag"><TextBlock Style="{StaticResource Icon}" Text="&#xE738;" /></Button>
                <WrapPanel x:Name="TagsPanel" VerticalAlignment="Center" Margin="8,0,0,0" />
            </DockPanel>
            <ListBox x:Name="FramesList" Height="84" SelectionChanged="OnFrameSelected" SelectionMode="Extended"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </DockPanel>

        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="#2B2B2B" PreviewMouseWheel="OnWheel" BorderThickness="2" BorderBrush="Transparent"
                      AutomationProperties.Name="Sprite canvas">
            <Grid x:Name="CanvasHost" Margin="40" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Cross"
                  MouseDown="OnCanvasDown" MouseMove="OnCanvasMove" MouseUp="OnCanvasUp" MouseLeave="OnCanvasLeave">
                <!-- tiled mode: the sprite repeated 3×3 around the real canvas -->
                <Rectangle x:Name="TiledChecker" Visibility="Collapsed" />
                <Rectangle x:Name="TiledBg" Opacity="0.55" Visibility="Collapsed" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <Grid x:Name="CanvasCore">
                <Rectangle x:Name="Checker" />
                <Image x:Name="CanvasImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <Rectangle x:Name="GridOverlay" IsHitTestVisible="False" />
                <Rectangle x:Name="TileGridOverlay" IsHitTestVisible="False" />
                <Canvas x:Name="Overlay" IsHitTestVisible="False">
                    <Line x:Name="MirrorXLine" Stroke="#C0FF00FF" StrokeThickness="1" StrokeDashArray="4 3" Visibility="Collapsed" />
                    <Line x:Name="MirrorYLine" Stroke="#C0FF00FF" StrokeThickness="1" StrokeDashArray="4 3" Visibility="Collapsed" />
                    <Rectangle x:Name="SelRectBack" Stroke="Black" StrokeThickness="1" Visibility="Collapsed" />
                    <Rectangle x:Name="SelRect" Stroke="White" StrokeThickness="1" StrokeDashArray="4 4" Visibility="Collapsed" />
                    <Path x:Name="SelPathBack" Stroke="Black" StrokeThickness="1" Visibility="Collapsed" />
                    <Path x:Name="SelPath" Stroke="White" StrokeThickness="1" StrokeDashArray="4 4" Visibility="Collapsed" />
                </Canvas>
                </Grid>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
