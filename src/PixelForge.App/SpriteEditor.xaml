<UserControl x:Class="PixelForge.App.SpriteEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="2" />
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Content="New" ToolTip="Ctrl+N" Click="OnNew" />
            <Button Content="Open" ToolTip="Ctrl+O (.pxf or image)" Click="OnOpen" />
            <Button Content="Save" ToolTip="Ctrl+S" Click="OnSave" />
            <Button Content="Save as" Click="OnSaveAs" />
            <Button Content="Export PNG" Click="OnExportPng" />
            <Separator />
            <Button Content="Canvas size…" Click="OnCanvasSize" />
            <Button Content="Crop" ToolTip="Crop canvas to the selection" Click="OnCrop" />
            <Separator />
            <Button Content="Undo" ToolTip="Ctrl+Z" Click="OnUndo" />
            <Button Content="Redo" ToolTip="Ctrl+Y" Click="OnRedo" />
            <Separator />
            <CheckBox x:Name="GridToggle" Content="Grid" ToolTip="Ctrl+G" IsChecked="True" Click="OnGridToggle" />
            <Separator />
            <TextBlock Text="Size " VerticalAlignment="Center" />
            <ComboBox x:Name="SizeBox" Width="44" SelectedIndex="0" ToolTip="Brush size  [ ]">
                <ComboBoxItem>1</ComboBoxItem><ComboBoxItem>2</ComboBoxItem><ComboBoxItem>3</ComboBoxItem><ComboBoxItem>4</ComboBoxItem>
                <ComboBoxItem>5</ComboBoxItem><ComboBoxItem>6</ComboBoxItem><ComboBoxItem>7</ComboBoxItem><ComboBoxItem>8</ComboBoxItem>
            </ComboBox>
            <CheckBox x:Name="FilledToggle" Content="Filled" ToolTip="Filled rectangles and ellipses" />
            <CheckBox x:Name="MirrorXToggle" Content="Mirror X" ToolTip="Mirror drawing left/right" Click="OnMirrorToggle" />
            <CheckBox x:Name="MirrorYToggle" Content="Mirror Y" ToolTip="Mirror drawing up/down" Click="OnMirrorToggle" />
            <Separator />
            <TextBlock x:Name="Status" VerticalAlignment="Center" Margin="8,0" />
        </ToolBar>

        <StackPanel x:Name="ToolsPanel" DockPanel.Dock="Left" Width="70" Margin="4">
            <RadioButton Tag="Pencil" Content="Pencil" ToolTip="B" IsChecked="True" GroupName="tool" Click="OnToolClick" />
            <RadioButton Tag="Eraser" Content="Eraser" ToolTip="E" GroupName="tool" Click="OnToolClick" />
            <RadioButton Tag="Fill" Content="Fill" ToolTip="G" GroupName="tool" Click="OnToolClick" />
            <RadioButton Tag="Picker" Content="Picker" ToolTip="I" GroupName="tool" Click="OnToolClick" />
            <RadioButton Tag="Line" Content="Line" ToolTip="L  (Shift: 45°)" GroupName="tool" Click="OnToolClick" />
            <RadioButton Tag="Rect" Content="Rect" ToolTip="U  (Shift: square)" GroupName="tool" Click="OnToolClick" />
            <RadioButton Tag="Ellipse" Content="Ellipse" ToolTip="O  (Shift: circle)" GroupName="tool" Click="OnToolClick" />
            <RadioButton Tag="Select" Content="Select" ToolTip="M — drag to select, drag inside to move. Ctrl+C/X/V, Del, H/V flip, R rotate, Enter apply, Esc cancel" GroupName="tool" Click="OnToolClick" />
            <Grid Height="56" Margin="2,12,2,0" ToolTip="Left/right mouse colors. Click to change.">
                <Border x:Name="SecondarySwatch" Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        BorderBrush="Gray" BorderThickness="1" MouseLeftButtonDown="OnSecondarySwatch" />
                <Border x:Name="PrimarySwatch" Width="34" Height="34" HorizontalAlignment="Left" VerticalAlignment="Top"
                        BorderBrush="White" BorderThickness="1" MouseLeftButtonDown="OnPrimarySwatch" />
            </Grid>
        </StackPanel>

        <DockPanel DockPanel.Dock="Right" Width="210" Margin="4">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <Button x:Name="PaletteMenuBtn" DockPanel.Dock="Right" Content="Palette ▾" Click="OnPaletteMenu">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Load palette… (.hex, .gpl)" Click="OnLoadPalette" />
                            <MenuItem Header="Save palette…" Click="OnSavePalette" />
                            <MenuItem Header="Reset to default (DB32)" Click="OnResetPalette" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <TextBlock Text="Left / right click. Alt+click removes." VerticalAlignment="Center" FontSize="11" Foreground="Gray" TextWrapping="Wrap" />
            </DockPanel>
            <WrapPanel x:Name="PaletteWrap" DockPanel.Dock="Top" />
            <TextBlock DockPanel.Dock="Top" Text="Layers" Margin="0,12,0,4" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                <Button Content="+" Width="30" ToolTip="Add layer" Click="OnAddLayer" />
                <Button Content="−" Width="30" ToolTip="Delete layer" Click="OnDeleteLayer" />
                <Button Content="▲" Width="30" ToolTip="Move up" Click="OnLayerUp" />
                <Button Content="▼" Width="30" ToolTip="Move down" Click="OnLayerDown" />
            </StackPanel>
            <ListBox x:Name="LayersList" SelectionChanged="OnLayerSelected" HorizontalContentAlignment="Stretch" />
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="4">
            <ToolBar DockPanel.Dock="Top">
                <TextBlock Text="Frames" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Button Content="+" ToolTip="New empty frame" Click="OnAddFrame" />
                <Button Content="Duplicate" ToolTip="Copy current frame" Click="OnDuplicateFrame" />
                <Button Content="−" ToolTip="Delete frame" Click="OnDeleteFrame" />
                <Button Content="◀" ToolTip="Move frame left" Click="OnFrameLeft" />
                <Button Content="▶" ToolTip="Move frame right" Click="OnFrameRight" />
                <TextBlock Text="  ms" VerticalAlignment="Center" />
                <TextBox x:Name="DurationBox" Width="50" ToolTip="Frame duration (Enter to apply)" KeyDown="OnDurationKey" LostKeyboardFocus="OnDurationCommit" />
                <Separator />
                <CheckBox x:Name="OnionToggle" Content="Onion skin" ToolTip="Show previous and next frame faintly" Click="OnOnionToggle" />
                <Separator />
                <ToggleButton x:Name="PlayBtn" Content="▶ Play" ToolTip="Space" Click="OnPlay" />
                <Separator />
                <Button Content="Export GIF" Click="OnExportGif" />
                <Button Content="Export sheet" ToolTip="Sprite sheet PNG + JSON" Click="OnExportSheet" />
            </ToolBar>
            <ListBox x:Name="FramesList" Height="84" SelectionChanged="OnFrameSelected"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </DockPanel>

        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="#2B2B2B" PreviewMouseWheel="OnWheel">
            <Grid x:Name="CanvasHost" Margin="40" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Cross"
                  MouseDown="OnCanvasDown" MouseMove="OnCanvasMove" MouseUp="OnCanvasUp" MouseLeave="OnCanvasLeave">
                <Rectangle>
                    <Rectangle.Fill>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="#CCCCCC" Geometry="M0,0 H16 V16 H0Z" />
                                    <GeometryDrawing Brush="#999999" Geometry="M0,0 H8 V8 H0Z M8,8 H16 V16 H8Z" />
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Image x:Name="CanvasImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <Rectangle x:Name="GridOverlay" IsHitTestVisible="False" />
                <Canvas x:Name="Overlay" IsHitTestVisible="False">
                    <Line x:Name="MirrorXLine" Stroke="#C0FF00FF" StrokeThickness="1" StrokeDashArray="4 3" Visibility="Collapsed" />
                    <Line x:Name="MirrorYLine" Stroke="#C0FF00FF" StrokeThickness="1" StrokeDashArray="4 3" Visibility="Collapsed" />
                    <Rectangle x:Name="SelRectBack" Stroke="Black" StrokeThickness="1" Visibility="Collapsed" />
                    <Rectangle x:Name="SelRect" Stroke="White" StrokeThickness="1" StrokeDashArray="4 4" Visibility="Collapsed" />
                </Canvas>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
