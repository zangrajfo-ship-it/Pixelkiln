<UserControl x:Class="PixelForge.App.PaintEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PixelForge.App"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <UserControl.Resources>
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="Field" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button ToolTip="New painting (Ctrl+N)" Click="OnNew"><TextBlock Style="{StaticResource Icon}" Text="&#xE7C3;" /></Button>
                <Button ToolTip="Open (Ctrl+O)" Click="OnOpen"><TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" /></Button>
                <Button ToolTip="Save (Ctrl+S)" Click="OnSave"><TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" /></Button>
                <Separator />
                <Button ToolTip="Undo (Ctrl+Z)" Click="OnUndo"><TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" /></Button>
                <Button ToolTip="Redo (Ctrl+Y)" Click="OnRedo"><TextBlock Style="{StaticResource Icon}" Text="&#xE7A6;" /></Button>
                <Separator />
                <Button ToolTip="Zoom out (Ctrl+-)" Click="OnZoomOut"><TextBlock Style="{StaticResource Icon}" Text="&#xE71F;" /></Button>
                <TextBlock x:Name="ZoomText" Width="56" TextAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Zoom level" />
                <Button ToolTip="Zoom in (Ctrl+=)" Click="OnZoomIn"><TextBlock Style="{StaticResource Icon}" Text="&#xE8A3;" /></Button>
                <Button ToolTip="Fit to window (Ctrl+0)" Click="OnZoomFit"><TextBlock Style="{StaticResource Icon}" Text="&#xE9A6;" /></Button>
                <Separator />
                <Button Content="Import image…" Click="OnImportImage" ToolTip="Add a picture as a new layer" />
                <Button Content="Export PNG…" Click="OnExportPng" ToolTip="Save the visible painting as a PNG (Ctrl+E)" />
                <Button Content="To pixel art…" Click="OnToPixel" ToolTip="Scale the painting down and open it in Pixel mode" />
            </ToolBar>
        </ToolBarTray>
        <Border DockPanel.Dock="Bottom" Padding="10,4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}">
            <TextBlock x:Name="Status" />
        </Border>

        <StackPanel x:Name="ToolsPanel" DockPanel.Dock="Left" Width="104" Margin="4">
            <RadioButton Tag="Brush" Content="Brush  B" ToolTip="Soft or hard round brush (B)" IsChecked="True" GroupName="painttool" Click="OnToolClick" />
            <RadioButton Tag="Pencil" Content="Pencil  N" ToolTip="Hard edge, no anti-aliasing (N)" GroupName="painttool" Click="OnToolClick" />
            <RadioButton Tag="Eraser" Content="Eraser  E" ToolTip="Erase; on a mask, reveal (E)" GroupName="painttool" Click="OnToolClick" />
            <RadioButton Tag="Airbrush" Content="Airbrush  A" ToolTip="Builds up while held (A)" GroupName="painttool" Click="OnToolClick" />
            <RadioButton Tag="Smudge" Content="Smudge  S" ToolTip="Drag colour along (S)" GroupName="painttool" Click="OnToolClick" />
            <RadioButton Tag="Picker" Content="Picker  I" ToolTip="Pick a colour from the picture (I, or Alt+click)" GroupName="painttool" Click="OnToolClick" />
            <RadioButton Tag="Gradient" Content="Gradient  G" ToolTip="Drag: primary to secondary colour over the layer (G)" GroupName="painttool" Click="OnToolClick" />
            <Grid Margin="2,12,2,0" Height="44">
                <Border x:Name="SecondarySwatch" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Bottom" BorderBrush="Gray" BorderThickness="1"
                        AutomationProperties.Name="Secondary color" ToolTip="Secondary colour (X swaps)" />
                <Border x:Name="PrimarySwatch" Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="White" BorderThickness="2"
                        AutomationProperties.Name="Primary color" ToolTip="Primary colour" />
            </Grid>
        </StackPanel>

        <ScrollViewer DockPanel.Dock="Right" Width="260" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10,4,8,4">
                <local:ColorPicker x:Name="Picker" Margin="0,0,0,6" />
                <TextBlock Text="Brush" FontWeight="SemiBold" />
                <TextBlock x:Name="SizeLabel" Style="{StaticResource Field}" Text="Size" />
                <Slider x:Name="SizeSlider" Minimum="1" Maximum="500" Value="24" SmallChange="1" LargeChange="10" AutomationProperties.Name="Brush size" ValueChanged="OnBrushChanged" />
                <TextBlock x:Name="HardLabel" Style="{StaticResource Field}" Text="Hardness" />
                <Slider x:Name="HardSlider" Minimum="0" Maximum="1" Value="0.6" SmallChange="0.05" LargeChange="0.1" AutomationProperties.Name="Brush hardness" ValueChanged="OnBrushChanged" />
                <TextBlock x:Name="OpacityLabel" Style="{StaticResource Field}" Text="Opacity" />
                <Slider x:Name="OpacitySlider" Minimum="0.01" Maximum="1" Value="1" SmallChange="0.05" LargeChange="0.1" AutomationProperties.Name="Brush opacity" ValueChanged="OnBrushChanged" />
                <TextBlock x:Name="FlowLabel" Style="{StaticResource Field}" Text="Flow" />
                <Slider x:Name="FlowSlider" Minimum="0.01" Maximum="1" Value="1" SmallChange="0.05" LargeChange="0.1" AutomationProperties.Name="Brush flow" ValueChanged="OnBrushChanged" />
                <TextBlock x:Name="SpacingLabel" Style="{StaticResource Field}" Text="Spacing" />
                <Slider x:Name="SpacingSlider" Minimum="0.02" Maximum="1" Value="0.12" SmallChange="0.01" LargeChange="0.05" AutomationProperties.Name="Brush spacing" ValueChanged="OnBrushChanged" />
                <TextBlock x:Name="GrainLabel" Style="{StaticResource Field}" Text="Grain (texture)" />
                <Slider x:Name="GrainSlider" Minimum="0" Maximum="1" Value="0" SmallChange="0.05" LargeChange="0.1" AutomationProperties.Name="Brush grain" ValueChanged="OnBrushChanged" />
                <TextBlock x:Name="SmoothLabel" Style="{StaticResource Field}" Text="Smoothing" />
                <Slider x:Name="SmoothSlider" Minimum="0" Maximum="10" Value="2" SmallChange="1" LargeChange="2" IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.Name="Stroke smoothing" ValueChanged="OnBrushChanged" />
                <CheckBox x:Name="PressureSizeBox" Content="Pen pressure changes size" IsChecked="True" Margin="0,8,0,0" Click="OnBrushChanged" />
                <CheckBox x:Name="PressureOpacityBox" Content="Pen pressure changes opacity" Click="OnBrushChanged" />
                <CheckBox x:Name="SquareBox" Content="Square tip" Click="OnBrushChanged" />
                <CheckBox x:Name="WrapBox" Content="Wrap around edges (seamless textures)" Click="OnBrushChanged" ToolTip="Strokes that leave one side continue on the opposite side (W)" />

                <TextBlock Text="Layers (top = front)" FontWeight="SemiBold" Margin="0,16,0,0" />
                <ListBox x:Name="LayersList" Height="150" Margin="0,4,0,0" SelectionChanged="OnLayerSelected" AutomationProperties.Name="Layers" />
                <WrapPanel Margin="0,4,0,0">
                    <Button Content="+" Width="34" Click="OnAddLayer" ToolTip="New layer" Margin="0,0,4,4" />
                    <Button Content="−" Width="34" Click="OnDeleteLayer" ToolTip="Delete layer" Margin="0,0,4,4" />
                    <Button Content="↑" Width="34" Click="OnLayerUp" ToolTip="Move layer up" Margin="0,0,4,4" />
                    <Button Content="↓" Width="34" Click="OnLayerDown" ToolTip="Move layer down" Margin="0,0,4,4" />
                    <Button Content="Rename" Click="OnRenameLayer" Margin="0,0,4,4" />
                </WrapPanel>
                <Label Content="_Blend mode" Target="{Binding ElementName=BlendBox}" Padding="0" Margin="0,4,0,0" />
                <ComboBox x:Name="BlendBox" SelectionChanged="OnLayerFieldChanged" />
                <TextBlock Text="Layer opacity" Style="{StaticResource Field}" />
                <Slider x:Name="LayerOpacitySlider" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" AutomationProperties.Name="Layer opacity"
                        Thumb.DragCompleted="OnLayerOpacityDone" KeyUp="OnLayerOpacityKey" />
                <CheckBox x:Name="VisibleBox" Content="Visible" Margin="0,8,0,0" Click="OnLayerFieldChanged" />
                <CheckBox x:Name="AlphaLockBox" Content="Lock transparency" Click="OnLayerFieldChanged" ToolTip="Paint only where the layer already has paint" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="MaskButton" Content="Add mask" Click="OnMask" Margin="0,0,6,0" />
                    <ToggleButton x:Name="EditMaskToggle" Content="Paint on mask" ToolTip="Brush hides, eraser reveals (M)" Click="OnEditMask" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource Bg0Brush}"
                      PreviewMouseWheel="OnWheel" BorderThickness="2" BorderBrush="Transparent" AutomationProperties.Name="Painting canvas">
            <Grid x:Name="CanvasHost" Margin="40" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Cross"
                  MouseDown="OnMouseDown" MouseMove="OnMouseMove" MouseUp="OnMouseUp" MouseLeave="OnMouseLeave"
                  StylusDown="OnStylusDown" StylusMove="OnStylusMove" StylusUp="OnStylusUp">
                <Rectangle x:Name="Checker" />
                <Image x:Name="CanvasImage" Stretch="Fill" />
                <Canvas x:Name="Overlay" IsHitTestVisible="False">
                    <Ellipse x:Name="BrushRing" Stroke="White" StrokeThickness="1" Visibility="Collapsed" />
                    <Ellipse x:Name="BrushRingDark" Stroke="Black" StrokeThickness="1" StrokeDashArray="3 3" Visibility="Collapsed" />
                    <Line x:Name="GradientLine" Stroke="White" StrokeThickness="1.5" StrokeDashArray="5 3" Visibility="Collapsed" />
                </Canvas>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
