<Window x:Class="PixelForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PixelForge.App"
        Title="PixelForge" Width="1440" Height="900" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg1Brush}"
        PreviewKeyDown="OnPreviewKeyDown" Closing="OnClosing">
    <DockPanel>
        <!-- top bar: logo, menus, modes, document, undo/redo, export -->
        <Border DockPanel.Dock="Top" Height="49" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                Padding="10,0">
            <DockPanel LastChildFill="True">
                <Button x:Name="LogoBtn" DockPanel.Dock="Left" Width="32" Height="32" Cursor="Hand" ToolTip="Start screen" Click="OnLogo"
                        AutomationProperties.Name="Start screen" FocusVisualStyle="{x:Null}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="8">
                                    <Canvas Width="18" Height="18">
                                        <Rectangle Canvas.Left="2" Canvas.Top="2" Width="6" Height="6" Fill="{DynamicResource OnAccentBrush}" />
                                        <Rectangle Canvas.Left="10" Canvas.Top="2" Width="6" Height="6" Fill="{DynamicResource OnAccentBrush}" Opacity="0.55" />
                                        <Rectangle Canvas.Left="2" Canvas.Top="10" Width="6" Height="6" Fill="{DynamicResource OnAccentBrush}" Opacity="0.55" />
                                        <Rectangle Canvas.Left="10" Canvas.Top="10" Width="6" Height="6" Fill="{DynamicResource OnAccentBrush}" />
                                    </Canvas>
                                </Border>
                                <Border x:Name="Focus" CornerRadius="10" Margin="-3" BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Menu x:Name="MainMenu" DockPanel.Dock="Left" Margin="8,0,0,0" VerticalAlignment="Center" Background="Transparent" />
                <Rectangle DockPanel.Dock="Left" Style="{StaticResource Divider}" />
                <Border DockPanel.Dock="Left" Style="{StaticResource SegmentBox}" CornerRadius="9" VerticalAlignment="Center">
                    <StackPanel x:Name="ModeTabs" Orientation="Horizontal" AutomationProperties.Name="Editors" />
                </Border>
                <Border x:Name="DocChip" DockPanel.Dock="Left" Margin="10,0,0,0" Height="32" Padding="12,0" CornerRadius="8" Background="{DynamicResource HoverBrush}"
                        VerticalAlignment="Center" ToolTip="Current document">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="DirtyDot" Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0" ToolTip="Unsaved changes" Visibility="Collapsed" />
                        <TextBlock x:Name="DocName" FontWeight="Medium" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                    </StackPanel>
                </Border>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Width="36" Height="36" ToolTip="Undo  Ctrl+Z" AutomationProperties.Name="Undo" Click="OnUndo">
                        <local:PathIcon Kind="undo" Width="18" Height="18" StrokeWidth="1.8" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="36" Height="36" ToolTip="Redo  Ctrl+Y" AutomationProperties.Name="Redo" Click="OnRedo">
                        <local:PathIcon Kind="redo" Width="18" Height="18" StrokeWidth="1.8" />
                    </Button>
                    <Rectangle Style="{StaticResource Divider}" Margin="4,0" />
                    <Button Style="{StaticResource PrimaryButton}" ToolTip="Export  Ctrl+Shift+E" AutomationProperties.Name="Export" Click="OnExport">
                        <StackPanel Orientation="Horizontal">
                            <local:PathIcon Kind="download" Width="15" Height="15" StrokeWidth="2.2" Margin="0,0,6,0" />
                            <TextBlock Text="Export" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Border />
            </DockPanel>
        </Border>

        <!-- status bar: the current editor's status (mirrored), autosave on the right -->
        <Border DockPanel.Dock="Bottom" Height="29" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="SavedDot" Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" Margin="0,0,6,0" Visibility="Collapsed" />
                    <TextBlock x:Name="SavedText" Style="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Text2Brush}" />
                </StackPanel>
                <TextBlock x:Name="MainStatus" Style="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Text2Brush}" TextTrimming="CharacterEllipsis"
                           AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="AssetsColumn" Width="270" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <local:AssetBrowser x:Name="Assets" Grid.Column="0" />
            <GridSplitter x:Name="AssetsSplitter" Grid.Column="1" Width="1" HorizontalAlignment="Stretch" Background="{DynamicResource LineBrush}"
                          AutomationProperties.Name="Resize asset browser" />
            <!-- the tab headers are hidden: the mode tabs in the top bar switch them -->
            <TabControl x:Name="Tabs" Grid.Column="2" SelectionChanged="OnTabChanged" Padding="0" BorderThickness="0" Background="{DynamicResource Bg1Brush}" Foreground="{DynamicResource TextBrush}">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <!-- the editors inherit their text colour from the tab item -->
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                    </Style>
                </TabControl.ItemContainerStyle>
                <TabItem Header="Sprite">
                    <local:SpriteEditor x:Name="SpriteEd" />
                </TabItem>
                <TabItem Header="Character">
                    <local:CharacterEditor x:Name="CharEd" />
                </TabItem>
                <TabItem Header="Tilemap">
                    <local:TilemapEditor x:Name="MapEd" />
                </TabItem>
                <TabItem Header="Scene">
                    <local:SceneEditor x:Name="SceneEd" />
                </TabItem>
                <TabItem Header="Audio">
                    <local:AudioStudio x:Name="AudioEd" />
                </TabItem>
                <TabItem Header="Music">
                    <local:MusicEditor x:Name="MusicEd" />
                </TabItem>
                <TabItem Header="SFX">
                    <local:SfxEditor x:Name="SfxEd" />
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
