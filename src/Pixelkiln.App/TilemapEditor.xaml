<UserControl x:Class="Pixelkiln.App.TilemapEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pixelkiln.App"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <DockPanel>
        <!-- the editor's status line; the main window shows it in its status bar -->
        <Border DockPanel.Dock="Bottom" Padding="10,4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}">
            <TextBlock x:Name="Status" />
        </Border>

        <!-- tool rail; the brush tile at the bottom -->
        <Border DockPanel.Dock="Left" Width="61" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,10">
                <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center" ToolTip="The tiles the brush paints (choose them in the tileset)">
                    <Border Width="32" Height="32" CornerRadius="4" Background="{DynamicResource Bg0Brush}" BorderBrush="{DynamicResource OutlineHoverBrush}" BorderThickness="1">
                        <Image x:Name="BrushPreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="Brush tiles" />
                    </Border>
                    <TextBlock Text="Brush" FontSize="10" Foreground="{DynamicResource Text3Brush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" AutomationProperties.Name="Map tools">
                    <RadioButton x:Name="PaintBtn" Style="{StaticResource RailTool}" Tag="Paint tile|B|pencil" ToolTip="Paint tile (B): paints the selected tiles (drag in the tileset for several). Right mouse erases."
                                 AutomationProperties.Name="Paint tile (B)" IsChecked="True" GroupName="mtool" Click="OnToolClick"><local:PathIcon Kind="pencil" /></RadioButton>
                    <RadioButton x:Name="FillBtn" Style="{StaticResource RailTool}" Tag="Fill area|G|bucket" ToolTip="Fill area (G): fills with the selected tiles as a pattern"
                                 AutomationProperties.Name="Fill area (G)" GroupName="mtool" Click="OnToolClick"><local:PathIcon Kind="bucket" /></RadioButton>
                    <RadioButton x:Name="EraseBtn" Style="{StaticResource RailTool}" Tag="Erase tile|E|eraser" ToolTip="Erase tile (E)"
                                 AutomationProperties.Name="Erase tile (E)" GroupName="mtool" Click="OnToolClick"><local:PathIcon Kind="eraser" /></RadioButton>
                    <RadioButton x:Name="PickBtn" Style="{StaticResource RailTool}" Tag="Pick tiles|I|picker" ToolTip="Pick tiles (I): click or drag on the map to copy tiles"
                                 AutomationProperties.Name="Pick tiles (I)" GroupName="mtool" Click="OnToolClick"><local:PathIcon Kind="picker" /></RadioButton>
                    <Rectangle Style="{StaticResource RailSep}" />
                    <RadioButton x:Name="AutoBtn" Style="{StaticResource RailTool}" Tag="Auto-tile|A|wand" ToolTip="Auto-tile (A): paints the chosen terrain, edges connect by themselves. Right mouse erases."
                                 AutomationProperties.Name="Auto-tile (A)" GroupName="mtool" Click="OnToolClick"><local:PathIcon Kind="wand" /></RadioButton>
                    <RadioButton x:Name="ObjectBtn" Style="{StaticResource RailTool}" Tag="Objects|O|marquee" ToolTip="Objects (O): drag = box, click = point. Click an object to select/move it. Shift snaps to tiles. Del removes."
                                 AutomationProperties.Name="Objects (O)" GroupName="mtool" Click="OnToolClick"><local:PathIcon Kind="marquee" /></RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- right panel: tileset, map layers, tile properties -->
        <Border DockPanel.Dock="Right" Width="297" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource PanelSection}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="Tileset: load, from Sprite tab, reload"
                                        AutomationProperties.Name="Tileset menu" Click="OnTilesetMenu">
                                    <local:PathIcon Kind="more" Width="15" Height="15" StrokeWidth="3" />
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Load… (PNG or .pxf)" Click="OnLoadTileset" />
                                            <MenuItem Header="From Sprite tab" Click="OnTilesetFromSprite" />
                                            <MenuItem Header="Reload from file" Click="OnReloadTileset" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <TextBlock Text="TILESET" Style="{StaticResource SectionHeader}" />
                            </DockPanel>
                            <Border Height="32" CornerRadius="6" Background="{DynamicResource Bg0Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="10,0" Margin="0,0,0,10">
                                <TextBlock x:Name="TilesetName" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" Text="No tileset" />
                            </Border>
                            <ScrollViewer MaxHeight="264" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource Bg0Brush}">
                                <Grid x:Name="TilesetHost" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="Hand" Focusable="True" Background="Transparent"
                                      AutomationProperties.Name="Tileset. Arrow keys select a tile, Shift+arrows select several." KeyDown="OnTilesetKey"
                                      MouseLeftButtonDown="OnTilesetDown" MouseMove="OnTilesetMove" MouseLeftButtonUp="OnTilesetUp">
                                    <Image x:Name="TilesetImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    <Rectangle x:Name="TilesetGrid" IsHitTestVisible="False" />
                                    <Canvas x:Name="CollisionMarks" IsHitTestVisible="False" />
                                    <Canvas IsHitTestVisible="False">
                                        <Rectangle x:Name="SelectionRect" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Fill="{DynamicResource AccentFaintBrush}" />
                                    </Canvas>
                                </Grid>
                            </ScrollViewer>
                            <TextBlock Text="TERRAIN (AUTO-TILE)" FontSize="11" Foreground="{DynamicResource Text3Brush}" Margin="0,12,0,6" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="Save a guide PNG showing which tile goes where"
                                        AutomationProperties.Name="Save terrain template" Click="OnTerrainTemplate"><local:PathIcon Kind="download" Width="15" Height="15" /></Button>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="Remove terrain"
                                        AutomationProperties.Name="Remove terrain" Click="OnRemoveTerrain"><local:PathIcon Kind="trash" Width="15" Height="15" /></Button>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="Add terrain from the selected 4×4 tiles"
                                        AutomationProperties.Name="Add terrain" Click="OnAddTerrain"><local:PathIcon Kind="plus" Width="15" Height="15" /></Button>
                                <ComboBox x:Name="TerrainBox" AutomationProperties.Name="Terrain" Margin="0,0,4,0" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelSection}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="Add layer" AutomationProperties.Name="Add layer" Click="OnAddLayer"><local:PathIcon Kind="plus" Width="15" Height="15" /></Button>
                                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="Delete layer" AutomationProperties.Name="Delete layer" Click="OnDeleteLayer"><local:PathIcon Kind="trash" Width="15" Height="15" /></Button>
                                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="Move layer up" AutomationProperties.Name="Move layer up" Click="OnLayerUp"><local:PathIcon Kind="up" Width="15" Height="15" /></Button>
                                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="Move layer down" AutomationProperties.Name="Move layer down" Click="OnLayerDown"><local:PathIcon Kind="down" Width="15" Height="15" /></Button>
                                </StackPanel>
                                <TextBlock Text="MAP LAYERS" Style="{StaticResource SectionHeader}" />
                            </DockPanel>
                            <ListBox x:Name="LayersList" SelectionChanged="OnLayerSelected" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" MaxHeight="180" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelSection}">
                        <StackPanel>
                            <TextBlock Text="TILE PROPERTIES" Style="{StaticResource SectionHeader}" Margin="0,0,0,10" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="64" Height="64" CornerRadius="8" Background="{DynamicResource Bg0Brush}" Margin="0,0,12,0">
                                    <Image x:Name="TilePreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="4" AutomationProperties.Name="Selected tile" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TileTitle" FontWeight="SemiBold" FontSize="14" Text="No tile" />
                                    <TextBlock x:Name="TileInfo" Style="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Text2Brush}" />
                                </StackPanel>
                            </StackPanel>
                            <CheckBox x:Name="SolidToggle" Content="Solid (blocks movement)" Margin="0,0,0,8" Click="OnSolidToggle"
                                      ToolTip="Gives the selected tiles a full collision box" />
                            <CheckBox x:Name="OneWayToggle" Content="One-way platform" Margin="0,0,0,8" Click="OnOneWayToggle"
                                      ToolTip="Gives the selected tiles a thin top you can jump through from below" />
                            <TextBlock Text="Other boxes: Tileset › Custom collision box." FontSize="11" Foreground="{DynamicResource Text3Brush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="ObjectPanel" Style="{StaticResource PanelSection}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="SELECTED OBJECT" Style="{StaticResource SectionHeader}" Margin="0,0,0,10" />
                            <DockPanel Margin="0,0,0,6"><Label Content="_Name" Target="{Binding ElementName=ObjNameBox}" Width="48" VerticalAlignment="Center" Padding="0" Foreground="{DynamicResource Text2Brush}" /><TextBox x:Name="ObjNameBox" AutomationProperties.Name="Object name" LostKeyboardFocus="OnObjectFieldCommit" KeyDown="OnObjectFieldKey" /></DockPanel>
                            <DockPanel Margin="0,0,0,6"><Label Content="T_ype" Target="{Binding ElementName=ObjTypeBox}" Width="48" VerticalAlignment="Center" Padding="0" Foreground="{DynamicResource Text2Brush}" /><TextBox x:Name="ObjTypeBox" AutomationProperties.Name="Object type" LostKeyboardFocus="OnObjectFieldCommit" KeyDown="OnObjectFieldKey" /></DockPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Content="Delete" Click="OnDeleteObject" />
                                <TextBlock x:Name="ObjInfo" Style="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- context bar: the current tool, its hint, the map size -->
        <Border DockPanel.Dock="Top" MinHeight="48" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,6">
            <DockPanel VerticalAlignment="Center">
                <TextBlock x:Name="MapInfo" DockPanel.Dock="Right" Style="{StaticResource Mono}" FontSize="12" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" Margin="14,0,0,0" />
                <StackPanel Orientation="Horizontal" MinWidth="130" VerticalAlignment="Center">
                    <local:PathIcon x:Name="ToolIcon" Kind="pencil" Width="18" Height="18" StrokeWidth="1.8" TextElement.Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
                    <TextBlock x:Name="ToolName" Text="Paint tile" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Border Style="{StaticResource Kbd}"><TextBlock x:Name="ToolKey" Text="B" FontFamily="{DynamicResource MonoFont}" FontSize="10" Foreground="{DynamicResource Text2Brush}" /></Border>
                </StackPanel>
                <Rectangle Style="{StaticResource Divider}" Margin="14,0" />
                <TextBlock x:Name="ToolHint" VerticalAlignment="Center" Foreground="{DynamicResource Text2Brush}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- map canvas with floating controls -->
        <Grid>
            <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource Bg0Brush}" PreviewMouseWheel="OnWheel" BorderThickness="2" BorderBrush="Transparent"
                          AutomationProperties.Name="Map canvas">
                <Grid x:Name="CanvasHost" Margin="40" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Cross"
                      MouseDown="OnCanvasDown" MouseMove="OnCanvasMove" MouseUp="OnCanvasUp" MouseLeave="OnCanvasLeave">
                    <Rectangle Fill="{DynamicResource LineBrush}" />
                    <Image x:Name="MapImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <Image x:Name="CollisionImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" IsHitTestVisible="False" Visibility="Collapsed" />
                    <Rectangle x:Name="GridOverlay" IsHitTestVisible="False" />
                    <Canvas IsHitTestVisible="False">
                        <Image x:Name="StampPreview" Opacity="0.6" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" Visibility="Collapsed" />
                        <Rectangle x:Name="PickRect" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeDashArray="3 2" Visibility="Collapsed" />
                    </Canvas>
                    <Canvas x:Name="ObjectsLayer" IsHitTestVisible="False" />
                </Grid>
            </ScrollViewer>
            <Border Style="{StaticResource FloatPanel}" HorizontalAlignment="Left" Margin="40,14,14,30">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" ToolTip="Zoom out  Ctrl+-" AutomationProperties.Name="Zoom out" Click="OnZoomOut"><local:PathIcon Kind="minus" Width="16" Height="16" /></Button>
                    <TextBlock x:Name="ZoomText" Style="{StaticResource Mono}" MinWidth="64" TextAlignment="Center" AutomationProperties.Name="Zoom level" />
                    <Button Style="{StaticResource IconButton}" ToolTip="Zoom in  Ctrl+=" AutomationProperties.Name="Zoom in" Click="OnZoomIn"><local:PathIcon Kind="plus" Width="16" Height="16" /></Button>
                    <Button Style="{StaticResource TextButton}" Content="Fit" FontSize="12" ToolTip="Fit to window  Ctrl+0" Click="OnZoomFit" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource FloatPanel}" HorizontalAlignment="Right" Margin="14,14,30,30">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="GridToggle" Style="{StaticResource IconToggle}" IsChecked="True" ToolTip="Tile grid  Ctrl+G" AutomationProperties.Name="Tile grid" Click="OnGridToggle"><local:PathIcon Kind="grid" Width="17" Height="17" /></ToggleButton>
                    <ToggleButton x:Name="CollisionToggle" ToolTip="Show solid tiles  K" AutomationProperties.Name="Show collision" Click="OnCollisionToggle" Height="32" Padding="10,0" Cursor="Hand" FocusVisualStyle="{x:Null}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Bd" CornerRadius="6" Background="Transparent" TextElement.Foreground="{DynamicResource Text2Brush}" Padding="{TemplateBinding Padding}" BorderThickness="0" BorderBrush="{DynamicResource AccentBrush}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <local:PathIcon Kind="collision" Width="15" Height="15" Margin="0,0,6,0" />
                                        <TextBlock Text="Collision" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#38E8505B" />
                                        <Setter TargetName="Bd" Property="TextElement.Foreground" Value="#FFB3B9" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
