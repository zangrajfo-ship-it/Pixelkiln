<UserControl x:Class="Pixelkiln.App.SpriteEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pixelkiln.App"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <UserControl.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <!-- the editor's status line; the main window shows it in its status bar -->
        <Border DockPanel.Dock="Bottom" Padding="10,4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}">
            <TextBlock x:Name="Status" />
        </Border>

        <!-- tool rail -->
        <Border DockPanel.Dock="Left" Width="61" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,10">
                <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center">
                    <Grid Width="44" Height="48" ToolTip="Left/right mouse colors. Click to change.">
                        <Button x:Name="SecondarySwatch" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Template="{StaticResource SwatchTemplate}" Click="OnSecondarySwatch" ToolTip="Right mouse color. Click to edit it in the color picker." />
                        <Button x:Name="PrimarySwatch" Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Template="{StaticResource SwatchTemplate}" Click="OnPrimarySwatch" ToolTip="Left mouse color. Click to edit it in the color picker." />
                    </Grid>
                    <Button Style="{StaticResource IconButton}" Width="44" Height="28" ToolTip="Swap colors  X" AutomationProperties.Name="Swap colors" Click="OnSwapColors">
                        <local:PathIcon Kind="swap" Width="16" Height="16" />
                    </Button>
                </StackPanel>
                <StackPanel x:Name="ToolsPanel" HorizontalAlignment="Center" AutomationProperties.Name="Tools">
                    <RadioButton Style="{StaticResource RailTool}" Tag="Pencil" ToolTip="Pencil (B)" AutomationProperties.Name="Pencil (B)" IsChecked="True" GroupName="tool" Click="OnToolClick"><local:PathIcon Kind="pencil" /></RadioButton>
                    <RadioButton Style="{StaticResource RailTool}" Tag="Eraser" ToolTip="Eraser (E)" AutomationProperties.Name="Eraser (E)" GroupName="tool" Click="OnToolClick"><local:PathIcon Kind="eraser" /></RadioButton>
                    <RadioButton Style="{StaticResource RailTool}" Tag="Fill" ToolTip="Paint bucket (G)" AutomationProperties.Name="Paint bucket (G)" GroupName="tool" Click="OnToolClick"><local:PathIcon Kind="bucket" /></RadioButton>
                    <RadioButton Style="{StaticResource RailTool}" Tag="Picker" ToolTip="Eyedropper (I)" AutomationProperties.Name="Eyedropper (I)" GroupName="tool" Click="OnToolClick"><local:PathIcon Kind="picker" /></RadioButton>
                    <Rectangle Style="{StaticResource RailSep}" />
                    <RadioButton Style="{StaticResource RailTool}" Tag="Line" ToolTip="Line (L). Shift: 45°" AutomationProperties.Name="Line (L)" GroupName="tool" Click="OnToolClick"><local:PathIcon Kind="line" /></RadioButton>
                    <RadioButton Style="{StaticResource RailTool}" Tag="Rect" ToolTip="Rectangle (U). Shift: square" AutomationProperties.Name="Rectangle (U)" GroupName="tool" Click="OnToolClick"><local:PathIcon Kind="rect" /></RadioButton>
                    <RadioButton Style="{StaticResource RailTool}" Tag="Ellipse" ToolTip="Ellipse (O). Shift: circle" AutomationProperties.Name="Ellipse (O)" GroupName="tool" Click="OnToolClick"><local:PathIcon Kind="ellipse" /></RadioButton>
                    <Rectangle Style="{StaticResource RailSep}" />
                    <RadioButton Style="{StaticResource RailTool}" Tag="Select" ToolTip="Rectangular marquee (M): drag to select, drag inside to move" AutomationProperties.Name="Rectangular marquee (M)" GroupName="tool" Click="OnToolClick"><local:PathIcon Kind="marquee" /></RadioButton>
                    <RadioButton Style="{StaticResource RailTool}" Tag="Wand" ToolTip="Magic wand (W): pixels of the same color" AutomationProperties.Name="Magic wand (W)" GroupName="tool" Click="OnToolClick"><local:PathIcon Kind="wand" /></RadioButton>
                    <Rectangle Style="{StaticResource RailSep}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- right panel: color, palette, layers -->
        <Border DockPanel.Dock="Right" Width="297" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource PanelSection}">
                    <StackPanel>
                        <TextBlock Text="COLOR" Style="{StaticResource SectionHeader}" Margin="0,0,0,10" />
                        <local:ColorPicker x:Name="Picker" />
                    </StackPanel>
                </Border>
                <Border DockPanel.Dock="Top" Style="{StaticResource PanelSection}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="Palette: load, save, reset"
                                    AutomationProperties.Name="Palette menu" Click="OnPaletteMenu">
                                <local:PathIcon Kind="more" Width="15" Height="15" StrokeWidth="3" />
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Load palette… (.hex, .gpl)" Click="OnLoadPalette" />
                                        <MenuItem Header="Save palette…" Click="OnSavePalette" />
                                        <MenuItem Header="Reset to default (DB32)" Click="OnResetPalette" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <TextBlock Text="PALETTE" Style="{StaticResource SectionHeader}" />
                        </DockPanel>
                        <WrapPanel x:Name="PaletteWrap" />
                        <TextBlock Text="Left / right click. Alt+click removes." FontSize="11" Foreground="{DynamicResource Text3Brush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Padding="14">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="Add layer" AutomationProperties.Name="Add layer" Click="OnAddLayer"><local:PathIcon Kind="plus" Width="15" Height="15" /></Button>
                                <Button Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="Delete layer" AutomationProperties.Name="Delete layer" Click="OnDeleteLayer"><local:PathIcon Kind="trash" Width="15" Height="15" /></Button>
                                <Button Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="Move layer up" AutomationProperties.Name="Move layer up" Click="OnLayerUp"><local:PathIcon Kind="up" Width="15" Height="15" /></Button>
                                <Button Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="Move layer down" AutomationProperties.Name="Move layer down" Click="OnLayerDown"><local:PathIcon Kind="down" Width="15" Height="15" /></Button>
                            </StackPanel>
                            <TextBlock Text="LAYERS" Style="{StaticResource SectionHeader}" />
                        </DockPanel>
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Label Content="_Opacity" Target="{Binding ElementName=OpacitySlider}" Padding="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource Text2Brush}" />
                            <TextBlock x:Name="OpacityValue" DockPanel.Dock="Right" Width="40" TextAlignment="Right" Style="{StaticResource Mono}" />
                            <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1"
                                    AutomationProperties.Name="Layer opacity in percent" PreviewMouseLeftButtonDown="OnOpacityDragStart" ValueChanged="OnOpacityChanged" />
                        </DockPanel>
                        <ListBox x:Name="LayersList" SelectionChanged="OnLayerSelected" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" />
                    </DockPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- context bar: the current tool and only its options -->
        <Border DockPanel.Dock="Top" MinHeight="48" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,6">
            <WrapPanel x:Name="ToolOptionsBar" VerticalAlignment="Center" AutomationProperties.Name="Tool options">
                <StackPanel Orientation="Horizontal" MinWidth="120" VerticalAlignment="Center">
                    <local:PathIcon x:Name="ToolIcon" Kind="pencil" Width="18" Height="18" StrokeWidth="1.8" TextElement.Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
                    <TextBlock x:Name="ToolName" Text="Pencil" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Border Style="{StaticResource Kbd}"><TextBlock x:Name="ToolKey" Text="B" FontFamily="{DynamicResource MonoFont}" FontSize="10" Foreground="{DynamicResource Text2Brush}" /></Border>
                </StackPanel>
                <Rectangle Style="{StaticResource Divider}" Margin="14,0" />
                <StackPanel x:Name="SizeOption" Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                    <Label Content="_Size" Target="{Binding ElementName=SizeSlider}" VerticalAlignment="Center" Padding="0,0,8,0" Foreground="{DynamicResource Text2Brush}" />
                    <Slider x:Name="SizeSlider" Width="110" Minimum="1" Maximum="8" Value="1" IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" VerticalAlignment="Center"
                            AutomationProperties.Name="Brush size" ToolTip="Brush size  [ and ]" />
                    <TextBlock Width="38" TextAlignment="Right" Style="{StaticResource Mono}" Text="{Binding Value, ElementName=SizeSlider, StringFormat={}{0:0} px}" />
                </StackPanel>
                <CheckBox x:Name="FilledToggle" Content="Filled" ToolTip="Filled rectangles and ellipses" Margin="0,0,14,0" VerticalAlignment="Center" />
                <CheckBox x:Name="PixelPerfectToggle" Content="Pixel-perfect" ToolTip="Removes the extra corner pixels in diagonal strokes (size 1)" IsChecked="True" Margin="0,0,14,0" VerticalAlignment="Center" />
                <CheckBox x:Name="ContiguousToggle" Content="Contiguous" ToolTip="On: only the touching area. Off: every pixel of that color." IsChecked="True" Margin="0,0,14,0" VerticalAlignment="Center" />
                <StackPanel x:Name="MirrorOption" Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="Mirror" Style="{StaticResource Lbl}" />
                    <Border Style="{StaticResource SegmentBox}">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="MirrorXToggle" Style="{StaticResource Segment}" Content="H" Height="26" ToolTip="Mirror drawing left/right" AutomationProperties.Name="Mirror horizontally" Click="OnMirrorToggle" />
                            <ToggleButton x:Name="MirrorYToggle" Style="{StaticResource Segment}" Content="V" Height="26" ToolTip="Mirror drawing up/down" AutomationProperties.Name="Mirror vertically" Click="OnMirrorToggle" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="ToolHint" VerticalAlignment="Center" Foreground="{DynamicResource Text2Brush}" TextWrapping="Wrap" MaxWidth="560" />
            </WrapPanel>
        </Border>

        <!-- timeline: transport, tags, frames as numbered pills -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="41" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Width="30" Height="30" ToolTip="First frame" AutomationProperties.Name="First frame" Click="OnFirstFrame"><local:PathIcon Kind="first" Width="15" Height="15" /></Button>
                        <Button Style="{StaticResource IconButton}" Width="30" Height="30" ToolTip="Previous frame  ←" AutomationProperties.Name="Previous frame" Click="OnPrevFrame"><local:PathIcon Kind="prev" Width="15" Height="15" /></Button>
                        <ToggleButton x:Name="PlayBtn" Style="{StaticResource PrimaryButton}" Width="40" Height="30" Padding="0" Margin="2,0" ToolTip="Play / stop  Space" AutomationProperties.Name="Play animation" Click="OnPlay">
                            <local:PathIcon x:Name="PlayIcon" Kind="play" Filled="True" Width="14" Height="14" />
                        </ToggleButton>
                        <Button Style="{StaticResource IconButton}" Width="30" Height="30" ToolTip="Next frame  →" AutomationProperties.Name="Next frame" Click="OnNextFrame"><local:PathIcon Kind="next" Width="15" Height="15" /></Button>
                        <Button Style="{StaticResource IconButton}" Width="30" Height="30" ToolTip="Last frame" AutomationProperties.Name="Last frame" Click="OnLastFrame"><local:PathIcon Kind="last" Width="15" Height="15" /></Button>
                        <Rectangle Style="{StaticResource Divider}" />
                        <Label Content="_Duration" Target="{Binding ElementName=DurationBox}" VerticalAlignment="Center" Padding="0,0,6,0" Foreground="{DynamicResource Text2Brush}" />
                        <TextBox x:Name="DurationBox" AutomationProperties.Name="Frame duration in milliseconds" Width="64" VerticalAlignment="Center" FontFamily="{DynamicResource MonoFont}"
                                 ToolTip="Frame duration in ms (Enter to apply)" KeyDown="OnDurationKey" LostKeyboardFocus="OnDurationCommit" />
                        <TextBlock Text="ms" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="12" />
                        <Rectangle Style="{StaticResource Divider}" />
                        <Button Style="{StaticResource IconButton}" Width="30" Height="30" ToolTip="New empty frame" AutomationProperties.Name="New empty frame" Click="OnAddFrame"><local:PathIcon Kind="plus" Width="15" Height="15" /></Button>
                        <Button Style="{StaticResource IconButton}" Width="30" Height="30" ToolTip="Duplicate frame" AutomationProperties.Name="Duplicate frame" Click="OnDuplicateFrame"><local:PathIcon Kind="duplicate" Width="15" Height="15" /></Button>
                        <Button Style="{StaticResource IconButton}" Width="30" Height="30" ToolTip="Delete frame" AutomationProperties.Name="Delete frame" Click="OnDeleteFrame"><local:PathIcon Kind="trash" Width="15" Height="15" /></Button>
                        <Button Style="{StaticResource IconButton}" Width="30" Height="30" ToolTip="Move frame left" AutomationProperties.Name="Move frame left" Click="OnFrameLeft"><local:PathIcon Kind="left" Width="15" Height="15" /></Button>
                        <Button Style="{StaticResource IconButton}" Width="30" Height="30" ToolTip="Move frame right" AutomationProperties.Name="Move frame right" Click="OnFrameRight"><local:PathIcon Kind="right" Width="15" Height="15" /></Button>
                    </StackPanel>
                </Border>
                <DockPanel DockPanel.Dock="Top" Height="30" Margin="8,0">
                    <TextBlock Text="TAGS" FontSize="11" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center" Margin="4,0,8,0" />
                    <Button Style="{StaticResource IconButton}" Width="26" Height="26" ToolTip="New tag from the selected frames (Shift+click frames to select several)" AutomationProperties.Name="New tag" Click="OnAddTag"><local:PathIcon Kind="plus" Width="14" Height="14" /></Button>
                    <Button Style="{StaticResource IconButton}" Width="26" Height="26" ToolTip="Set the chosen tag to the selected frames" AutomationProperties.Name="Set tag to selected frames" Click="OnSetTagRange"><local:PathIcon Kind="tag" Width="14" Height="14" /></Button>
                    <Button Style="{StaticResource IconButton}" Width="26" Height="26" ToolTip="Rename the chosen tag" AutomationProperties.Name="Rename tag" Click="OnRenameTag"><local:PathIcon Kind="pencil" Width="14" Height="14" /></Button>
                    <Button Style="{StaticResource IconButton}" Width="26" Height="26" ToolTip="Delete the chosen tag" AutomationProperties.Name="Delete tag" Click="OnDeleteTag"><local:PathIcon Kind="trash" Width="14" Height="14" /></Button>
                    <WrapPanel x:Name="TagsPanel" VerticalAlignment="Center" Margin="8,0,0,0" />
                </DockPanel>
                <ListBox x:Name="FramesList" Height="44" Margin="6,0,6,6" SelectionChanged="OnFrameSelected" SelectionMode="Extended" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Frames">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,2,0" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Width="36" Height="28" CornerRadius="6" Background="Transparent" BorderThickness="0" BorderBrush="{DynamicResource AccentRingBrush}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- canvas with floating controls -->
        <Grid>
            <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource Bg0Brush}" PreviewMouseWheel="OnWheel" BorderThickness="2" BorderBrush="Transparent"
                          AutomationProperties.Name="Sprite canvas">
                <Grid x:Name="CanvasHost" Margin="40" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Cross"
                      MouseDown="OnCanvasDown" MouseMove="OnCanvasMove" MouseUp="OnCanvasUp" MouseLeave="OnCanvasLeave">
                    <!-- tiled mode: the sprite repeated 3×3 around the real canvas -->
                    <Rectangle x:Name="TiledChecker" Visibility="Collapsed" />
                    <Rectangle x:Name="TiledBg" Opacity="0.55" Visibility="Collapsed" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <Grid x:Name="CanvasCore">
                    <Rectangle x:Name="Checker" />
                    <Image x:Name="CanvasImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <Rectangle x:Name="GridOverlay" IsHitTestVisible="False" />
                    <Rectangle x:Name="TileGridOverlay" IsHitTestVisible="False" />
                    <Canvas x:Name="Overlay" IsHitTestVisible="False">
                        <Line x:Name="MirrorXLine" Stroke="#C0FF00FF" StrokeThickness="1" StrokeDashArray="4 3" Visibility="Collapsed" />
                        <Line x:Name="MirrorYLine" Stroke="#C0FF00FF" StrokeThickness="1" StrokeDashArray="4 3" Visibility="Collapsed" />
                        <Rectangle x:Name="SelRectBack" Stroke="Black" StrokeThickness="1" Visibility="Collapsed" />
                        <Rectangle x:Name="SelRect" Stroke="White" StrokeThickness="1" StrokeDashArray="4 4" Visibility="Collapsed" />
                        <Path x:Name="SelPathBack" Stroke="Black" StrokeThickness="1" Visibility="Collapsed" />
                        <Path x:Name="SelPath" Stroke="White" StrokeThickness="1" StrokeDashArray="4 4" Visibility="Collapsed" />
                    </Canvas>
                    </Grid>
                </Grid>
            </ScrollViewer>
            <Border Style="{StaticResource FloatPanel}" HorizontalAlignment="Left" Margin="40,14,14,30">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" ToolTip="Zoom out  Ctrl+-" AutomationProperties.Name="Zoom out" Click="OnZoomOut"><local:PathIcon Kind="minus" Width="16" Height="16" /></Button>
                    <TextBlock x:Name="ZoomText" Style="{StaticResource Mono}" MinWidth="64" TextAlignment="Center" AutomationProperties.Name="Zoom level" />
                    <Button Style="{StaticResource IconButton}" ToolTip="Zoom in  Ctrl+=" AutomationProperties.Name="Zoom in" Click="OnZoomIn"><local:PathIcon Kind="plus" Width="16" Height="16" /></Button>
                    <Button Style="{StaticResource TextButton}" Content="Fit" FontSize="12" ToolTip="Fit to window  Ctrl+0" Click="OnZoomFit" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource FloatPanel}" HorizontalAlignment="Right" Margin="14,14,30,30">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="GridToggle" Style="{StaticResource IconToggle}" IsChecked="True" ToolTip="Pixel grid  Ctrl+G" AutomationProperties.Name="Pixel grid" Click="OnGridToggle"><local:PathIcon Kind="grid" Width="17" Height="17" /></ToggleButton>
                    <ToggleButton x:Name="TileGridToggle" Style="{StaticResource IconToggle}" ToolTip="Tile grid (size in View)  Ctrl+Shift+G" AutomationProperties.Name="Tile grid" Click="OnGridToggle"><local:PathIcon Kind="tiles" Width="17" Height="17" /></ToggleButton>
                    <ToggleButton x:Name="TiledToggle" Style="{StaticResource IconToggle}" ToolTip="Tiled mode: seamless tiles  T" AutomationProperties.Name="Tiled mode" Click="OnTiledToggle"><local:PathIcon Kind="tiled" Width="17" Height="17" /></ToggleButton>
                    <ToggleButton x:Name="OnionToggle" Style="{StaticResource IconToggle}" ToolTip="Onion skin: previous and next frame faintly" AutomationProperties.Name="Onion skin" Click="OnOnionToggle"><local:PathIcon Kind="onion" Width="17" Height="17" /></ToggleButton>
                    <Button Style="{StaticResource IconButton}" ToolTip="Preview window  P" AutomationProperties.Name="Preview window" Click="OnPreview"><local:PathIcon Kind="preview" Width="17" Height="17" /></Button>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
