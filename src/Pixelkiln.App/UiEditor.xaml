<UserControl x:Class="Pixelkiln.App.UiEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pixelkiln.App"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <UserControl.Resources>
        <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Padding" Value="6,2" />
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button ToolTip="New UI kit (Ctrl+N)" Click="OnNew"><TextBlock Style="{StaticResource Icon}" Text="&#xE7C3;" /></Button>
                <Button ToolTip="Open (Ctrl+O)" Click="OnOpen"><TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" /></Button>
                <Button ToolTip="Save (Ctrl+S)" Click="OnSave"><TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" /></Button>
                <Separator />
                <Button ToolTip="Undo (Ctrl+Z)" Click="OnUndo"><TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" /></Button>
                <Button ToolTip="Redo (Ctrl+Y)" Click="OnRedo"><TextBlock Style="{StaticResource Icon}" Text="&#xE7A6;" /></Button>
                <Separator />
                <Button ToolTip="Zoom out (Ctrl+-)" Click="OnZoomOut"><TextBlock Style="{StaticResource Icon}" Text="&#xE71F;" /></Button>
                <TextBlock x:Name="ZoomText" Width="52" TextAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Zoom level" />
                <Button ToolTip="Zoom in (Ctrl+=)" Click="OnZoomIn"><TextBlock Style="{StaticResource Icon}" Text="&#xE8A3;" /></Button>
                <Separator />
                <TextBlock Text="Preview at " VerticalAlignment="Center" />
                <ComboBox x:Name="DeviceBox" Width="190" SelectionChanged="OnDeviceChanged" AutomationProperties.Name="Preview resolution"
                          ToolTip="See a screen at another resolution: anchors move elements as they will in the game" />
                <Separator />
                <Button Content="Export element PNGs…" Click="OnExportPngs" ToolTip="Every element state as a PNG (the project export also writes atlas, JSON and the Godot theme)" />
            </ToolBar>
        </ToolBarTray>
        <Border DockPanel.Dock="Bottom" Padding="10,4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}">
            <TextBlock x:Name="Status" />
        </Border>

        <ScrollViewer DockPanel.Dock="Left" Width="230" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="6,4,8,4">
                <Label Content="_Elements" Target="{Binding ElementName=ElementsList}" Padding="0" FontWeight="SemiBold" />
                <ListBox x:Name="ElementsList" Height="200" Margin="0,4,0,0" SelectionChanged="OnElementSelected" />
                <WrapPanel Margin="0,4,0,0">
                    <ComboBox x:Name="NewKindBox" Width="110" Margin="0,0,4,4" AutomationProperties.Name="Kind of new element" />
                    <Button Style="{StaticResource Small}" Content="Add" Click="OnAddElement" />
                    <Button Style="{StaticResource Small}" Content="Duplicate" Click="OnDuplicateElement" />
                    <Button Style="{StaticResource Small}" Content="Delete" Click="OnDeleteElement" />
                </WrapPanel>
                <Label Content="_Screens" Target="{Binding ElementName=ScreensList}" Padding="0" FontWeight="SemiBold" Margin="0,12,0,0" />
                <ListBox x:Name="ScreensList" Height="170" Margin="0,4,0,0" SelectionChanged="OnScreenSelected" />
                <WrapPanel Margin="0,4,0,0">
                    <Button Style="{StaticResource Small}" Content="Add screen…" Click="OnAddScreen" />
                    <Button Style="{StaticResource Small}" Content="Delete" Click="OnDeleteScreen" />
                    <Button Style="{StaticResource Small}" Content="Place element" Click="OnPlace" ToolTip="Put the selected element on the screen (P)" />
                </WrapPanel>
                <Button Content="Style…" Margin="0,12,0,0" HorizontalAlignment="Left" Click="OnShowStyle" ToolTip="Colours, corners, border and font of every element" />
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer DockPanel.Dock="Right" Width="270" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10,4,8,4">
                <TextBlock x:Name="PropsTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                <!-- style -->
                <StackPanel x:Name="StyleProps">
                    <WrapPanel Margin="0,6,0,0">
                        <RadioButton x:Name="ColBase" Content="Base" IsChecked="True" GroupName="uicol" Click="OnStyleColorTarget" />
                        <RadioButton x:Name="ColAccent" Content="Accent" GroupName="uicol" Click="OnStyleColorTarget" />
                        <RadioButton x:Name="ColDark" Content="Dark" GroupName="uicol" Click="OnStyleColorTarget" />
                        <RadioButton x:Name="ColLight" Content="Light" GroupName="uicol" Click="OnStyleColorTarget" />
                        <RadioButton x:Name="ColText" Content="Text" GroupName="uicol" Click="OnStyleColorTarget" />
                    </WrapPanel>
                    <local:ColorPicker x:Name="Picker" Margin="0,4,0,0" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <Label Content="_Corner radius" Target="{Binding ElementName=RadiusBox}" Padding="0" VerticalAlignment="Center" />
                        <TextBox x:Name="RadiusBox" Grid.Column="1" Margin="0,2" LostKeyboardFocus="OnStyleCommit" />
                        <Label Grid.Row="1" Content="_Border" Target="{Binding ElementName=BorderBox}" Padding="0" VerticalAlignment="Center" />
                        <TextBox x:Name="BorderBox" Grid.Row="1" Grid.Column="1" Margin="0,2" LostKeyboardFocus="OnStyleCommit" />
                        <Label Grid.Row="2" Content="_Font size" Target="{Binding ElementName=FontBox}" Padding="0" VerticalAlignment="Center" />
                        <TextBox x:Name="FontBox" Grid.Row="2" Grid.Column="1" Margin="0,2" LostKeyboardFocus="OnStyleCommit" />
                    </Grid>
                    <CheckBox x:Name="PixelBox" Content="Pixel-art edges (no blur)" Margin="0,6,0,0" Click="OnStyleCommit" />
                </StackPanel>
                <!-- element -->
                <StackPanel x:Name="ElementProps">
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <Label Content="_Name" Target="{Binding ElementName=ElNameBox}" Padding="0" VerticalAlignment="Center" />
                        <TextBox x:Name="ElNameBox" Grid.Column="1" Margin="0,2" LostKeyboardFocus="OnElementCommit" />
                        <Label Grid.Row="1" Content="_Kind" Target="{Binding ElementName=ElKindBox}" Padding="0" VerticalAlignment="Center" />
                        <ComboBox x:Name="ElKindBox" Grid.Row="1" Grid.Column="1" Margin="0,2" SelectionChanged="OnElementCommit" />
                        <Label Grid.Row="2" Content="_Width × height" Target="{Binding ElementName=ElWBox}" Padding="0" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                            <TextBox x:Name="ElWBox" Width="56" LostKeyboardFocus="OnElementCommit" />
                            <TextBox x:Name="ElHBox" Width="56" Margin="4,0,0,0" AutomationProperties.Name="Element height" LostKeyboardFocus="OnElementCommit" />
                        </StackPanel>
                        <Label Grid.Row="3" Content="Nine-slice _margin" Target="{Binding ElementName=ElMarginBox}" Padding="0" VerticalAlignment="Center" />
                        <TextBox x:Name="ElMarginBox" Grid.Row="3" Grid.Column="1" Margin="0,2" LostKeyboardFocus="OnElementCommit" ToolTip="Border in pixels that is not stretched" />
                        <Label Grid.Row="4" Content="_Label" Target="{Binding ElementName=ElLabelBox}" Padding="0" VerticalAlignment="Center" />
                        <TextBox x:Name="ElLabelBox" Grid.Row="4" Grid.Column="1" Margin="0,2" LostKeyboardFocus="OnElementCommit" />
                        <Label Grid.Row="5" Content="_Icon picture" Target="{Binding ElementName=ElIconBox}" Padding="0" VerticalAlignment="Center" />
                        <ComboBox x:Name="ElIconBox" Grid.Row="5" Grid.Column="1" Margin="0,2" SelectionChanged="OnElementCommit" />
                    </Grid>
                    <TextBlock Text="Art per state (empty = drawn from the style)" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <Grid x:Name="ArtGrid" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    </Grid>
                </StackPanel>
                <!-- placement -->
                <StackPanel x:Name="PlacementProps">
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <Label Content="_X, Y" Target="{Binding ElementName=PlXBox}" Padding="0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                            <TextBox x:Name="PlXBox" Width="56" LostKeyboardFocus="OnPlacementCommit" />
                            <TextBox x:Name="PlYBox" Width="56" Margin="4,0,0,0" AutomationProperties.Name="Y" LostKeyboardFocus="OnPlacementCommit" />
                        </StackPanel>
                        <Label Grid.Row="1" Content="Width × _height" Target="{Binding ElementName=PlWBox}" Padding="0" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                            <TextBox x:Name="PlWBox" Width="56" LostKeyboardFocus="OnPlacementCommit" />
                            <TextBox x:Name="PlHBox" Width="56" Margin="4,0,0,0" AutomationProperties.Name="Height" LostKeyboardFocus="OnPlacementCommit" />
                        </StackPanel>
                        <Label Grid.Row="2" Content="_Anchor" Target="{Binding ElementName=PlAnchorBox}" Padding="0" VerticalAlignment="Center" />
                        <ComboBox x:Name="PlAnchorBox" Grid.Row="2" Grid.Column="1" Margin="0,2" SelectionChanged="OnPlacementCommit" />
                        <Label Grid.Row="3" Content="_Text" Target="{Binding ElementName=PlTextBox}" Padding="0" VerticalAlignment="Center" />
                        <TextBox x:Name="PlTextBox" Grid.Row="3" Grid.Column="1" Margin="0,2" LostKeyboardFocus="OnPlacementCommit" ToolTip="Dialogs: title|body" />
                        <Label Grid.Row="4" Content="_State" Target="{Binding ElementName=PlStateBox}" Padding="0" VerticalAlignment="Center" />
                        <ComboBox x:Name="PlStateBox" Grid.Row="4" Grid.Column="1" Margin="0,2" SelectionChanged="OnPlacementCommit" />
                        <Label Grid.Row="5" Content="_Value (bars)" Target="{Binding ElementName=PlValueBox}" Padding="0" VerticalAlignment="Center" />
                        <TextBox x:Name="PlValueBox" Grid.Row="5" Grid.Column="1" Margin="0,2" LostKeyboardFocus="OnPlacementCommit" ToolTip="0 to 1" />
                    </Grid>
                    <Button Content="Remove from screen" HorizontalAlignment="Left" Margin="0,6,0,0" Click="OnRemovePlacement" />
                </StackPanel>
                <!-- screen -->
                <StackPanel x:Name="ScreenProps">
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <Label Content="_Name" Target="{Binding ElementName=ScNameBox}" Padding="0" VerticalAlignment="Center" />
                        <TextBox x:Name="ScNameBox" Grid.Column="1" Margin="0,2" LostKeyboardFocus="OnScreenCommit" />
                        <Label Grid.Row="1" Content="_Design size" Target="{Binding ElementName=ScWBox}" Padding="0" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                            <TextBox x:Name="ScWBox" Width="56" LostKeyboardFocus="OnScreenCommit" />
                            <TextBox x:Name="ScHBox" Width="56" Margin="4,0,0,0" AutomationProperties.Name="Design height" LostKeyboardFocus="OnScreenCommit" />
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="ScOverlayBox" Content="Transparent (overlay on the game)" Margin="0,6,0,0" Click="OnScreenCommit" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource Bg0Brush}" PreviewMouseWheel="OnWheel"
                      AutomationProperties.Name="UI preview">
            <Grid x:Name="CanvasHost" Margin="30" HorizontalAlignment="Center" VerticalAlignment="Center"
                  MouseLeftButtonDown="OnCanvasDown" MouseMove="OnCanvasMove" MouseLeftButtonUp="OnCanvasUp">
                <Rectangle x:Name="Checker" />
                <Image x:Name="View" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <Canvas x:Name="Overlay" IsHitTestVisible="False" />
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
