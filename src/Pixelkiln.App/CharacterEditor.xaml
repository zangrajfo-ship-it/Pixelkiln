<UserControl x:Class="Pixelkiln.App.CharacterEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pixelkiln.App"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <UserControl.Resources>
        <Style x:Key="Lbl" TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="BarLbl" TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
            <Setter Property="Padding" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <!-- the editor's status line; the main window shows it in its status bar -->
        <Border DockPanel.Dock="Bottom" Padding="10,4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}">
            <TextBlock x:Name="Status" />
        </Border>

        <!-- left panel: what the character is -->
        <Border DockPanel.Dock="Left" Width="297" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource PanelSection}">
                        <StackPanel>
                            <TextBlock Text="CHARACTER" Style="{StaticResource SectionHeader}" Margin="0,0,0,10" />
                            <Label Content="_Sprite" Target="{Binding ElementName=SpriteBox}" Style="{StaticResource Lbl}" />
                            <ComboBox x:Name="SpriteBox" SelectionChanged="OnSpriteChosen" Margin="0,0,0,10" ToolTip="Sprite asset of the open project" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Label Content="_Kind" Target="{Binding ElementName=KindBox}" Style="{StaticResource Lbl}" />
                                    <ComboBox x:Name="KindBox" SelectionChanged="OnKindChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Content="_Facing" Target="{Binding ElementName=FacingBox}" Style="{StaticResource Lbl}" ToolTip="The direction the sprite is drawn in" />
                                    <ComboBox x:Name="FacingBox" SelectionChanged="OnFacingChanged" ToolTip="The direction the sprite is drawn in" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Origin  (Alt+click in the preview)" Foreground="{DynamicResource Text2Brush}" Margin="0,0,0,4" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="X" Style="{StaticResource Mono}" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox x:Name="OriginXBox" Width="70" FontFamily="{DynamicResource MonoFont}" AutomationProperties.Name="Origin X" LostKeyboardFocus="OnOriginCommit" KeyDown="OnFieldKey" />
                                <TextBlock Text="Y" Style="{StaticResource Mono}" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center" Margin="14,0,6,0" />
                                <TextBox x:Name="OriginYBox" Width="70" FontFamily="{DynamicResource MonoFont}" AutomationProperties.Name="Origin Y" LostKeyboardFocus="OnOriginCommit" KeyDown="OnFieldKey" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelSection}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="Add state" AutomationProperties.Name="Add state" Click="OnAddState"><local:PathIcon Kind="plus" Width="15" Height="15" /></Button>
                                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="Remove the state shown in the preview" AutomationProperties.Name="Remove state" Click="OnRemoveState"><local:PathIcon Kind="trash" Width="15" Height="15" /></Button>
                                </StackPanel>
                                <TextBlock Text="STATES" Style="{StaticResource SectionHeader}" />
                            </DockPanel>
                            <TextBlock Text="Each state plays a tag of the sprite." FontSize="11" Foreground="{DynamicResource Text3Brush}" Margin="0,0,0,8" />
                            <StackPanel x:Name="StatesPanel" />
                            <Button Style="{StaticResource OutlineButton}" Content="Add standard states" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnTemplate"
                                    ToolTip="Adds idle, walk, run, jump, attack, hurt and death tags to the sprite where missing" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelSection}">
                        <StackPanel>
                            <TextBlock Text="PROPERTIES" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                            <Label Content="_Key = value, one per line" Target="{Binding ElementName=PropsBox}" Style="{StaticResource Lbl}" FontSize="11" />
                            <TextBox x:Name="PropsBox" AcceptsReturn="True" MinHeight="80" TextWrapping="NoWrap" FontFamily="{DynamicResource MonoFont}" LostKeyboardFocus="OnPropsCommit"
                                     ToolTip="Game data passed to exports, e.g. hp = 3" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- right panel: hit and hurt boxes -->
        <Border DockPanel.Dock="Right" Width="297" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
            <DockPanel Margin="14">
                <TextBlock DockPanel.Dock="Top" Text="BOXES" Style="{StaticResource SectionHeader}" />
                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Text3Brush}" Margin="0,6,0,12"
                           Text="Drag in the preview to draw a box. Click a box to select it; arrows move it, Shift+arrows resize, Del removes." />
                <StackPanel DockPanel.Dock="Top">
                    <Label Content="New box _kind" Target="{Binding ElementName=BoxKindBox}" Style="{StaticResource Lbl}" />
                    <ComboBox x:Name="BoxKindBox" Margin="0,0,0,10" />
                    <Label Content="_Collision category" Target="{Binding ElementName=CategoryBox}" Style="{StaticResource Lbl}" />
                    <ComboBox x:Name="CategoryBox" Margin="0,0,0,10" />
                    <CheckBox x:Name="ThisFrameOnly" Content="Only this frame" Margin="0,0,0,6" />
                    <CheckBox x:Name="ThisStateOnly" Content="Only this state" IsChecked="True" Margin="0,0,0,12" />
                </StackPanel>
                <ListBox x:Name="BoxList" SelectionChanged="OnBoxSelected" AutomationProperties.Name="Boxes of the character" Background="Transparent" BorderThickness="0" />
            </DockPanel>
        </Border>

        <!-- context bar: which state plays and how fast (export is in the File menu) -->
        <Border DockPanel.Dock="Top" MinHeight="48" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,6">
            <DockPanel VerticalAlignment="Center">
                <WrapPanel VerticalAlignment="Center">
                    <Label Content="S_tate" Target="{Binding ElementName=StateBox}" Style="{StaticResource BarLbl}" />
                    <ComboBox x:Name="StateBox" Width="110" SelectionChanged="OnStateChanged" VerticalAlignment="Center" />
                    <ToggleButton x:Name="PlayBtn" Style="{StaticResource PrimaryButton}" Content="▶ Play" Height="32" Margin="10,0,0,0" Click="OnPlay"
                                  ToolTip="Play the state  Space" VerticalAlignment="Center" />
                    <Label Content="Spee_d" Target="{Binding ElementName=SpeedBox}" Style="{StaticResource BarLbl}" Margin="14,0,0,0" />
                    <ComboBox x:Name="SpeedBox" Width="68" SelectionChanged="OnSpeedChanged" VerticalAlignment="Center" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- frame scrubber and the state that follows -->
        <Border DockPanel.Dock="Bottom" Height="48" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,0">
            <DockPanel VerticalAlignment="Center">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="FrameText" Width="90" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Mono}" Foreground="{DynamicResource Text2Brush}" Margin="0,0,14,0" />
                    <Label Content="T_hen" Target="{Binding ElementName=ThenBox}" Style="{StaticResource BarLbl}" />
                    <ComboBox x:Name="ThenBox" Width="110" VerticalAlignment="Center" ToolTip="Transition preview: after one pass of the state, play this one" />
                </StackPanel>
                <TextBlock Text="FRAME" FontSize="11" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Slider x:Name="FrameSlider" Minimum="0" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnFrameSlider" VerticalAlignment="Center"
                        AutomationProperties.Name="Frame in the state" />
            </DockPanel>
        </Border>

        <!-- preview -->
        <ScrollViewer x:Name="PreviewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource Bg0Brush}">
            <Grid x:Name="PreviewHost" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Cursor="Cross" Focusable="True"
                  AutomationProperties.Name="Character preview"
                  MouseLeftButtonDown="OnPreviewDown" MouseMove="OnPreviewMove" MouseLeftButtonUp="OnPreviewUp" KeyDown="OnPreviewKey">
                <Rectangle x:Name="PreviewChecker" />
                <Image x:Name="PreviewImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <Canvas x:Name="BoxLayer" IsHitTestVisible="False" />
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
